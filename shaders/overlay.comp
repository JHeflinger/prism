#version 450

struct RayGenerator {
	float time;
    uint tid;
};

layout(binding = 0) readonly buffer RayGeneratorSSBOIn {
   RayGenerator raygenIn[ ];
};

layout(binding = 1, rgba8) uniform image2D outputImage;

layout(binding = 2) uniform OverlayUniformBufferObject {
	uint mouse_x;
    uint mouse_y;
	uint image_width;
	uint image_height;
	uint single_selected_tid;
    uint divisor;
} ubo;

layout(binding = 3) buffer OverlaySSBO {
	uint hovered_tid;
};

layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

const float mixfactor = 0.2;

void highlight_triangle(uint htid) {
	int rx = int(gl_GlobalInvocationID.x%ubo.image_width);
    int ry = int(gl_GlobalInvocationID.x/ubo.image_width);
    if (htid != -1 && raygenIn[gl_GlobalInvocationID.x].tid == htid) {
        int radius = 2;
		int minx = 0;
		int miny = 0;
		int maxx = rx;
		int maxy = ry;
		if (rx > radius) minx = rx - radius;
		if (ry > radius) miny = ry - radius;
		if (maxx + radius < ubo.image_width) maxx += radius;
		if (maxy + radius < ubo.image_height) maxy += radius;
		bool border = false;
		for (int x = minx; x < maxx; x++) {
			for (int y = miny; y < maxy; y++) {
				RayGenerator rg = raygenIn[y*ubo.image_width + x];
				if (rg.tid != htid) {
					border = true;
				}
			}
		}
        float divisor = float(ubo.divisor) * (1.0 - mixfactor);
		if (border) {
			imageStore(outputImage, ivec2(rx, ry), vec4(1.0, 0.52, 0.0, 1.0) / divisor);
		} else {
			vec4 oldc = imageLoad(outputImage, ivec2(rx, ry));
			imageStore(outputImage, ivec2(rx, ry), mix(oldc, vec4(1.0, 0.52, 0.0, 1.0) / divisor, mixfactor));
		}
    }
}

void outline_triangle() {
	int rx = int(gl_GlobalInvocationID.x%ubo.image_width);
    int ry = int(gl_GlobalInvocationID.x/ubo.image_width);
    uint tid = raygenIn[gl_GlobalInvocationID.x].tid;
    if (tid != -1) {
        int radius = 1;
        int minx = 0;
        int miny = 0;
        int maxx = rx;
        int maxy = ry;
        if (rx > radius) minx = rx - radius;
		if (ry > radius) miny = ry - radius;
		if (maxx + radius < ubo.image_width) maxx += radius;
		if (maxy + radius < ubo.image_height) maxy += radius;
		bool border = false;
		for (int x = minx; x < maxx; x++) {
			for (int y = miny; y < maxy; y++) {
				RayGenerator rg = raygenIn[y*ubo.image_width + x];
				if (rg.tid != tid) {
					border = true;
				}
			}
		}
		if (border) {
			imageStore(outputImage, ivec2(rx, ry), vec4(0.1, 0.1, 0.1, 1.0));
        }
    }
}

void main() {
    if (ubo.divisor == 1.0)
        outline_triangle();
    highlight_triangle(hovered_tid);
	if (hovered_tid != ubo.single_selected_tid)
		highlight_triangle(ubo.single_selected_tid);
}
