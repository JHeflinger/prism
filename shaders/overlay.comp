#import Boilerplate
#import Definitions

#import RayGeneratorDef;
#import RayDef;
#import TriangleDef;
#import VertexSkinDef;

layout(binding = 0) readonly #import RayGeneratorSSBODef; 
layout(binding = 1, rgba8) #import OutputImageDef;
layout(binding = 2) #import OverlayUniformBufferObjectDef o_ubo;
layout(binding = 3) #import GeometryUniformBufferObjectDef g_ubo;
layout(binding = 4) #import OverlaySSBODef;
layout(binding = 5) readonly #import TransformedVertexSSBODef;
layout(binding = 6) readonly #import TriangleSSBODef;
layout(binding = 7) #import UniformBufferObjectDef ubo;
layout(binding = 8) readonly #import SkinSSBODef;

#import CreateSimpleRay

const float vhighlight_radius = 50.0;
const float mixfactor = 0.2;
vec4 highlight_color;
vec4 lock_color;

void calculate_highlight_color() {
    float divisor = float(o_ubo.divisor) * (1.0 - mixfactor);
    highlight_color = vec4(0.0, 1.0, 0.52, 1.0) / divisor;
    lock_color = vec4(0.9, 0.12, 0.05, 1.0) / divisor;
}

void highlight_triangle(uint htid) {
	int rx = int(gl_GlobalInvocationID.x%o_ubo.image_width);
    int ry = int(gl_GlobalInvocationID.x/o_ubo.image_width);
    if (htid != -1 && raygenIn[gl_GlobalInvocationID.x].tid == htid) {
        int radius = 2;
		int minx = 0;
		int miny = 0;
		int maxx = rx;
		int maxy = ry;
		if (rx > radius) minx = rx - radius;
		if (ry > radius) miny = ry - radius;
		if (maxx + radius < o_ubo.image_width) maxx += radius;
		if (maxy + radius < o_ubo.image_height) maxy += radius;
		bool border = false;
		for (int x = minx; x < maxx; x++) {
			for (int y = miny; y < maxy; y++) {
				RayGenerator rg = raygenIn[y*o_ubo.image_width + x];
				if (rg.tid != htid) {
					border = true;
				}
			}
		}
		if (border) {
			imageStore(outputImage, ivec2(rx, ry), highlight_color);
		} else {
			vec4 oldc = imageLoad(outputImage, ivec2(rx, ry));
			imageStore(outputImage, ivec2(rx, ry), mix(oldc, highlight_color, mixfactor));
		}
    }
}

bool in_object(uint id, uvec4 range) {
    return id != uint(-1) && ((id >= range.x && id <= range.y) || (id >= range.z && id <= range.w));
}

void highlight_object(uvec4 range, float fill) {
    if (range.x > range.y && range.z > range.w) return;
	int rx = int(gl_GlobalInvocationID.x%o_ubo.image_width);
    int ry = int(gl_GlobalInvocationID.x/o_ubo.image_width);
    if (!in_object(raygenIn[gl_GlobalInvocationID.x].tid, range)) return;
    int radius = 2;
    int minx = max(rx - radius, 0);
    int miny = max(ry - radius, 0);
    int maxx = min(rx + radius, int(o_ubo.image_width) - 1);
    int maxy = min(ry + radius, int(o_ubo.image_height) - 1);
    bool border = false;
    for (int x = minx; x <= maxx && !border; x++)
        for (int y = miny; y <= maxy; y++)
            if (!in_object(raygenIn[y*o_ubo.image_width + x].tid, range)) { border = true; break; }
    if (border) {
        imageStore(outputImage, ivec2(rx, ry), highlight_color);
    } else {
        vec4 oldc = imageLoad(outputImage, ivec2(rx, ry));
        imageStore(outputImage, ivec2(rx, ry), mix(oldc, highlight_color, fill));
    }
}

void highlight_vertex(uint hvid, vec2 vpos) {
    if (hvid != -1) {
	    int rx = int(gl_GlobalInvocationID.x%o_ubo.image_width);
        int ry = int(gl_GlobalInvocationID.x/o_ubo.image_width);
        vec4 color = highlight_color;
        if (vertexIn[hvid].w != 0) color = lock_color;
        if (length(vec2(rx, ry) - vpos) < 3.0) {
			imageStore(outputImage, ivec2(rx, ry), color);
        }
    }
}

const float WIRE_WIDTH = 1.25;
const float WIRE_REFERENCE_HEIGHT = 900.0;
const int WIRE_MAX_RADIUS = 3;
const int WIRE_MAX_IDS = 16;

vec3 to_camera(vec3 p) {
    vec3 rel = p - ubo.position;
    return vec3(dot(rel, ubo.u), dot(rel, ubo.v), -dot(rel, ubo.w));
}

vec2 to_pixel(vec3 c) {
    vec2 s;
    if (ubo.ortho != 0u) {
        s = c.xy * (ubo.height / ubo.orthosize);
    } else {
        float focal = (cos(ubo.fov / 2.0) / sin(ubo.fov / 2.0)) * (ubo.width / 2.0);
        s = c.xy * (focal / c.z);
    }
    return vec2(s.x + ubo.width * 0.5, ubo.height * 0.5 - s.y);
}

float edge_distance(vec3 a, vec3 b, vec2 p, float near) {
    if (ubo.ortho == 0u) {
        if (a.z < near && b.z < near) return FLTMAX;
        if (a.z < near) a = mix(a, b, (near - a.z) / (b.z - a.z));
        else if (b.z < near) b = mix(b, a, (near - b.z) / (a.z - b.z));
    }
    vec2 sa = to_pixel(a);
    vec2 ab = to_pixel(b) - sa;
    vec2 ap = p - sa;
    float h = clamp(dot(ap, ab) / max(dot(ab, ab), 1e-12), 0.0, 1.0);
    return length(ap - ab * h);
}

float triangle_edge_distance(uint tid, vec2 p, float near) {
    Triangle t = triangleIn[tid];
    vec3 a = to_camera(vertexIn[t.a].xyz);
    vec3 b = to_camera(vertexIn[t.b].xyz);
    vec3 c = to_camera(vertexIn[t.c].xyz);
    return min(min(edge_distance(a, b, p, near), edge_distance(b, c, p, near)), edge_distance(c, a, p, near));
}

void outline_triangle() {
    int rx = int(gl_GlobalInvocationID.x % o_ubo.image_width);
    int ry = int(gl_GlobalInvocationID.x / o_ubo.image_width);
    uint own = raygenIn[gl_GlobalInvocationID.x].tid;
    float width = WIRE_WIDTH * ubo.height / WIRE_REFERENCE_HEIGHT;
    float strength = min(width, 1.0);
    int radius = clamp(int(ceil(max(width, 1.0) * 0.5 + 0.5)), 1, WIRE_MAX_RADIUS);
    float half_width = min(max(width, 1.0) * 0.5, float(radius) - 0.5);
    uint ids[WIRE_MAX_IDS];
    float depths[WIRE_MAX_IDS];
    int count = 0;
    bool uniform_block = true;
    for (int dy = -radius; dy <= radius; dy++) {
        for (int dx = -radius; dx <= radius; dx++) {
            int x = rx + dx;
            int y = ry + dy;
            if (x < 0 || y < 0 || x >= int(o_ubo.image_width) || y >= int(o_ubo.image_height)) continue;
            RayGenerator rg = raygenIn[y * o_ubo.image_width + x];
            if (rg.tid != own) uniform_block = false;
            if (rg.tid >= ubo.triangles) continue;
            bool seen = false;
            for (int k = 0; k < count; k++) seen = seen || ids[k] == rg.tid;
            if (!seen && count < WIRE_MAX_IDS) {
                ids[count] = rg.tid;
                depths[count] = rg.distance;
                count++;
            }
        }
    }
    if (uniform_block || count == 0) return;
    float scene = length(g_ubo.maxBB - g_ubo.minBB);
    float near = 1e-4 * scene;
    vec2 p = vec2(rx, ry) + 0.5;
    float best = FLTMAX;
    float bestdepth = 0.0;
    for (int k = 0; k < count; k++) {
        float e = triangle_edge_distance(ids[k], p, near);
        if (e < best) {
            best = e;
            bestdepth = depths[k];
        }
    }
    float coverage = clamp(half_width + 0.5 - best, 0.0, 1.0) * strength;
    if (coverage <= 0.0) return;
    float d = bestdepth / scene;
    vec4 oldc = imageLoad(outputImage, ivec2(rx, ry));
    vec4 newc = vec4(0.1, 0.1, 0.1, 1.0);
    float vdist = vhighlight_radius;
    vec3 mixc = vec3(0);
    float vsum = 0;
    if (o_ubo.single_selected_vid != -1) {
        vdist = length(selected_vertex_position - vec2(rx, ry));
        float swapdist = vhighlight_radius - vdist;
        if (vdist < vhighlight_radius) {
            if (vertexIn[o_ubo.single_selected_vid].w != 0) {
                mixc += swapdist * vec3(lock_color);
            } else {
                mixc += swapdist * vec3(highlight_color);
            }
            vsum += swapdist;
        }
    }
    if (o_ubo.mode == VERTEX_SELECT && hovered_tid != o_ubo.single_selected_vid && hovered_tid != -1) {
        float olddist = vdist;
        vdist = length(vertex_position - vec2(rx, ry));
        float swapdist = vhighlight_radius - vdist;
        if (vdist < vhighlight_radius) {
            if (vertexIn[hovered_tid].w != 0) {
                mixc += swapdist * vec3(lock_color);
            } else {
                mixc += swapdist * vec3(highlight_color);
            }
            vsum += swapdist;
        }
        vdist = min(vdist, olddist);
    }
    if (vdist < vhighlight_radius) {
        float mixing = 1.0 - (vdist / vhighlight_radius);
        mixing = mixing*mixing*mixing;
        newc = mix(newc, vec4(mixc / vsum, 1.0), mixing);
    }
    imageStore(outputImage, ivec2(rx, ry), mix(oldc, newc, coverage * min(1.0 / d, 1.0)));
}

float bone_weight(uint vid) {
    VertexSkin skin = skinIn[vid - o_ubo.weight_vstart + o_ubo.weight_skinstart];
    float w = 0.0;
    for (int i = 0; i < MAX_BONE_INFLUENCES; i++)
        if (skin.indices[i] == o_ubo.weight_bone) w += skin.weights[i];
    return w;
}

vec3 weight_ramp(float w) {
    w = clamp(w, 0.0, 1.0);
    vec3 c0 = vec3(0.02, 0.03, 0.40);
    vec3 c1 = vec3(0.00, 0.55, 0.85);
    vec3 c2 = vec3(0.10, 0.85, 0.15);
    vec3 c3 = vec3(0.95, 0.90, 0.10);
    vec3 c4 = vec3(0.95, 0.10, 0.05);
    if (w < 0.25) return mix(c0, c1, w / 0.25);
    if (w < 0.5) return mix(c1, c2, (w - 0.25) / 0.25);
    if (w < 0.75) return mix(c2, c3, (w - 0.5) / 0.25);
    return mix(c3, c4, (w - 0.75) / 0.25);
}

void show_weights() {
    if (o_ubo.weight_bone == uint(-1) || o_ubo.divisor != 1u) return;
    RayGenerator rg = raygenIn[gl_GlobalInvocationID.x];
    if (rg.tid == uint(-1) || rg.tid < o_ubo.weight_tstart || rg.tid > o_ubo.weight_tend || rg.distance < 0.0) return;
    int rx = int(gl_GlobalInvocationID.x % o_ubo.image_width);
    int ry = int(gl_GlobalInvocationID.x / o_ubo.image_width);
    Ray ray = create_ray(vec2(rx, ry));
    vec3 p = ray.position + ray.direction * rg.distance;
    Triangle t = triangleIn[rg.tid];
    vec3 a = vertexIn[t.a].xyz;
    vec3 e0 = vertexIn[t.b].xyz - a;
    vec3 e1 = vertexIn[t.c].xyz - a;
    vec3 e2 = p - a;
    float d00 = dot(e0, e0), d01 = dot(e0, e1), d11 = dot(e1, e1), d20 = dot(e2, e0), d21 = dot(e2, e1);
    float denom = d00 * d11 - d01 * d01;
    if (abs(denom) < 1e-30) return;
    float v = clamp((d11 * d20 - d01 * d21) / denom, 0.0, 1.0);
    float w = clamp((d00 * d21 - d01 * d20) / denom, 0.0, 1.0);
    float u = clamp(1.0 - v - w, 0.0, 1.0);
    float weight = u * bone_weight(t.a) + v * bone_weight(t.b) + w * bone_weight(t.c);
    vec4 oldc = imageLoad(outputImage, ivec2(rx, ry));
    float shade = clamp(dot(oldc.rgb, vec3(0.299, 0.587, 0.114)) * 1.4, 0.25, 1.0);
    imageStore(outputImage, ivec2(rx, ry), vec4(weight_ramp(weight) * shade, 1.0));
}

void main() {
    calculate_highlight_color();
    show_weights();
    if (o_ubo.divisor == 1.0 && o_ubo.wireframe != 0)
        outline_triangle();
    if (o_ubo.mode == TRIANGLE_SELECT)
        highlight_triangle(hovered_tid);
    else if (o_ubo.mode == VERTEX_SELECT)
        highlight_vertex(hovered_tid, vertex_position);
	if (o_ubo.mode != TRIANGLE_SELECT || hovered_tid != o_ubo.single_selected_tid)
		highlight_triangle(o_ubo.single_selected_tid);
	if (o_ubo.mode != VERTEX_SELECT || hovered_tid != o_ubo.single_selected_vid)
		highlight_vertex(o_ubo.single_selected_vid, selected_vertex_position);
    if (o_ubo.mode == LIGHT_SELECT) {
        if (hovered_tid != uint(-1) && hovered_tid < o_ubo.light_count && hovered_tid != o_ubo.single_selected_lid)
            highlight_triangle(o_ubo.light_base + hovered_tid);
        if (o_ubo.single_selected_lid != uint(-1) && o_ubo.single_selected_lid < o_ubo.light_count)
            highlight_triangle(o_ubo.light_base + o_ubo.single_selected_lid);
    }
    if (o_ubo.mode == CAMERA_SELECT) {
        if (hovered_tid != uint(-1) && hovered_tid < o_ubo.camera_count && hovered_tid != o_ubo.single_selected_cid)
            highlight_triangle(o_ubo.camera_base + hovered_tid);
        if (o_ubo.single_selected_cid != uint(-1) && o_ubo.single_selected_cid < o_ubo.camera_count)
            highlight_triangle(o_ubo.camera_base + o_ubo.single_selected_cid);
    }
    uvec4 hovered_object = uvec4(o_ubo.hovered_tstart, o_ubo.hovered_tend, o_ubo.hovered_sstart, o_ubo.hovered_send);
    uvec4 selected_object = uvec4(o_ubo.selected_tstart, o_ubo.selected_tend, o_ubo.selected_sstart, o_ubo.selected_send);
    if (o_ubo.mode == OBJECT_SELECT && hovered_object != selected_object)
        highlight_object(hovered_object, mixfactor * 0.5);
    highlight_object(selected_object, mixfactor);
}
