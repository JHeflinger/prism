    #define OBJECT_SELECT 5
    #define CAMERA_SELECT 6
    #define MAX_CAMERA_GLYPHS 64
    #define EPS 0.000001
    #define DEBUG_NONE 0
    #define DEBUG_NORMALS 1
    #define DEBUG_BVH 2
    #define DEBUG_BOUNCES 3
    #define DEBUG_SSS_PATH 4
    #define DEBUG_SSS_COST 5
    #define FLTMAX 3.402823466e+38
    #define LAMBERTIAN_MODEL 2
    #define MIRROR_MODEL 5
    #define DIELECTRIC_MODEL 7
    #define SUBSURFACE_MODEL 11
    #define PI 3.14159265358979323846
