export Boilerplate {
    #version 450
    layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
}

export Definitions {
    #define MAX_RECURSIVE_DEPTH 500
    #define NO_SELECT 0
    #define TRIANGLE_SELECT 1
    #define VERTEX_SELECT 2
    #define EPS 0.000001
    #define DEBUG_NONE 0
    #define DEBUG_NORMALS 1
    #define DEBUG_BVH 2
    #define DEBUG_BOUNCES 3
    #define FLTMAX 3.402823466e+38
    #define LAMBERTIAN_MODEL 2
    #define MIRROR_MODEL 5
    #define DIELECTRIC_MODEL 7
    #define PI 3.14159265358979323846
    #define MAX_BONE_INFLUENCES 4
}

