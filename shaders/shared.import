export CreateSimpleRay {
    Ray create_ray(vec2 rg) {
    	float r = ubo.width / 2.0;
    	float b = ubo.height / 2.0;
    	float l = -1.0 * r;
    	float t = -1.0 * b;
        float u = l + ((r - l) * (float(rg.x) + 0.5)) / ubo.width;
        float v = b + ((t - b) * (float(rg.y) + 0.5)) / ubo.height;
    	float d = (cos(ubo.fov / 2.0) / sin(ubo.fov / 2.0)) * r;
        Ray ray;
        if (ubo.ortho != 0u) {
            float world_per_pixel = ubo.orthosize / ubo.height;
            ray.direction = normalize(-ubo.w);
            ray.position = ubo.position + ((ubo.u * u) + (ubo.v * v)) * world_per_pixel;
        } else {
            ray.direction = normalize((ubo.u * u) + (ubo.v * v) - (ubo.w * d));
            ray.position = ubo.position;
        }
        return ray;
    }
}

export LightGlyphSuite {
    const float LIGHT_GLYPH_SPHERE_PX = 9.0;
    const float LIGHT_GLYPH_CONE_PX = 34.0;
    const float LIGHT_GLYPH_MIN_HALF_ANGLE = 0.05;
    const float LIGHT_GLYPH_MAX_HALF_ANGLE = 1.31;
    const uint LIGHT_GLYPH_NONE = 0u;
    const uint LIGHT_GLYPH_SPOT = 1u;
    const uint LIGHT_GLYPH_POINT = 2u;

    uint light_glyph_type(SceneLight light) {
        if (light.direction == vec3(0)) return LIGHT_GLYPH_POINT;
        if (light.angle != 0.0) return LIGHT_GLYPH_SPOT;
        return LIGHT_GLYPH_NONE;
    }

    float glyph_world_per_pixel(vec3 point) {
        if (ubo.ortho != 0u) return ubo.orthosize / ubo.height;
        float d = (cos(ubo.fov / 2.0) / sin(ubo.fov / 2.0)) * (ubo.width / 2.0);
        float depth = max(dot(point - ubo.position, -ubo.w), EPS);
        return depth / d;
    }

    bool glyph_sphere(Ray ray, vec3 center, float radius, inout float t, inout vec3 n) {
        vec3 oc = ray.position - center;
        float b = dot(oc, ray.direction);
        float c = dot(oc, oc) - radius * radius;
        float h = b * b - c;
        if (h < 0.0) return false;
        h = sqrt(h);
        float tt = -b - h;
        if (tt <= EPS) tt = -b + h;
        if (tt <= EPS || tt >= t) return false;
        t = tt;
        n = normalize(ray.position + ray.direction * tt - center);
        return true;
    }

    bool glyph_cone(Ray ray, vec3 apex, vec3 axis, float halfangle, float height, inout float t, inout vec3 n) {
        bool found = false;
        float cosa = cos(halfangle);
        float c2 = cosa * cosa;
        vec3 co = ray.position - apex;
        float dv = dot(ray.direction, axis);
        float cv = dot(co, axis);
        float a = dv * dv - c2;
        float b = 2.0 * (dv * cv - c2 * dot(ray.direction, co));
        float c = cv * cv - c2 * dot(co, co);
        if (abs(a) > EPS) {
            float disc = b * b - 4.0 * a * c;
            if (disc >= 0.0) {
                float sq = sqrt(disc);
                float roots[2] = float[2]((-b - sq) / (2.0 * a), (-b + sq) / (2.0 * a));
                for (int i = 0; i < 2; i++) {
                    float tt = roots[i];
                    if (tt <= EPS || tt >= t) continue;
                    vec3 cp = co + ray.direction * tt;
                    float h = dot(cp, axis);
                    if (h < 0.0 || h > height) continue; // mirrored nappe or past the base
                    t = tt;
                    n = normalize(c2 * cp - h * axis);
                    found = true;
                }
            }
        }
        if (abs(dv) > EPS) {
            float tt = (height - cv) / dv;
            if (tt > EPS && tt < t) {
                vec3 radial = co + ray.direction * tt - axis * height;
                float rb = height * tan(halfangle);
                if (dot(radial, radial) <= rb * rb) {
                    t = tt;
                    n = axis;
                    found = true;
                }
            }
        }
        return found;
    }

    uint trace_light_glyphs(Ray ray, out float t, out vec3 n) {
        t = FLTMAX;
        n = vec3(0, 0, 1);
        uint id = uint(-1);
        for (uint i = 0; i < ubo.lights; i++) {
            SceneLight light = lightIn[i];
            uint type = light_glyph_type(light);
            bool hit = false;
            if (type == LIGHT_GLYPH_POINT) {
                hit = glyph_sphere(ray, light.position,
                    LIGHT_GLYPH_SPHERE_PX * glyph_world_per_pixel(light.position), t, n);
            } else if (type == LIGHT_GLYPH_SPOT) {
                float halfangle = clamp(radians(abs(light.angle) / 2.0), LIGHT_GLYPH_MIN_HALF_ANGLE, LIGHT_GLYPH_MAX_HALF_ANGLE);
                float slant = LIGHT_GLYPH_CONE_PX * glyph_world_per_pixel(light.position);
                hit = glyph_cone(ray, light.position, normalize(light.direction), halfangle,
                    slant * cos(halfangle), t, n);
            }
            if (hit) id = i;
        }
        if (dot(n, ray.direction) > 0.0) n = -n;
        return id;
    }

    vec3 light_glyph_color(SceneLight light, Ray ray, vec3 n) {
        float m = max(max(light.color.r, light.color.g), light.color.b);
        vec3 hue = m > EPS ? max(light.color, vec3(0)) / m : vec3(0.6);
        hue = mix(hue, vec3(1.0), 0.35);
        float facing = max(dot(n, -ray.direction), 0.0);
        return hue * (0.35 + 0.65 * facing);
    }
}

export CameraGlyphSuite {
    const float CAMERA_GLYPH_BODY_W = 7.0; // body hext extents (px)
    const float CAMERA_GLYPH_BODY_H = 5.0;
    const float CAMERA_GLYPH_BODY_D = 8.0;
    const float CAMERA_GLYPH_FRUSTUM_PX = 42.0; // frustum depth / max far hext width (px)
    const float CAMERA_GLYPH_EDGE_PX = 1.25; // hext thickness of frustum edge lines (px)
    const float CAMERA_GLYPH_ORTHO_HALF = 0.45; // ortho frustum hext height as a fraction of its depth
    const uint CAMERA_GLYPH_NONE = 0u;
    const uint CAMERA_GLYPH_SOLID = 1u; // body, up tick, frustum edges
    const uint CAMERA_GLYPH_FACE = 2u; // translucent frustum sides

    struct CameraGlyph {
        vec3 position;
        vec3 u;
        vec3 v;
        vec3 w;
        float tanx;
        float tany;
        bool ortho;
        float aspect;
    };

    CameraGlyph load_camera_glyph(uint i) {
        CameraGlyph g;
        vec4 a = o_ubo.camera_glyphs[i * 4u + 0u];
        vec4 b = o_ubo.camera_glyphs[i * 4u + 1u];
        vec4 c = o_ubo.camera_glyphs[i * 4u + 2u];
        vec4 d = o_ubo.camera_glyphs[i * 4u + 3u];
        g.position = a.xyz;
        g.u = b.xyz;
        g.v = c.xyz;
        g.w = d.xyz;
        g.aspect = clamp(b.w, 0.25, 4.0);
        g.tanx = a.w;
        g.tany = a.w / g.aspect;
        g.ortho = c.w != 0.0;
        return g;
    }

    float camera_glyph_wpp(vec3 point) {
        if (ubo.ortho != 0u) return ubo.orthosize / ubo.height;
        float d = (cos(ubo.fov / 2.0) / sin(ubo.fov / 2.0)) * (ubo.width / 2.0);
        float depth = max(dot(point - ubo.position, -ubo.w), EPS);
        return depth / d;
    }

    bool cg_box(Ray ray, vec3 center, vec3 ax, vec3 ay, vec3 az, vec3 hext, float band, float tmax, out float t, out vec3 n, out bool edge) {
        t = FLTMAX; n = vec3(0); edge = false;
        vec3 rel = ray.position - center;
        vec3 o = vec3(dot(rel, ax), dot(rel, ay), dot(rel, az));
        vec3 d = vec3(dot(ray.direction, ax), dot(ray.direction, ay), dot(ray.direction, az));
        d = mix(d, mix(vec3(1e-20), vec3(-1e-20), lessThan(d, vec3(0.0))), lessThan(abs(d), vec3(1e-20)));
        vec3 inv = 1.0 / d;
        vec3 t0 = (-hext - o) * inv;
        vec3 t1 = (hext - o) * inv;
        vec3 tlo = min(t0, t1);
        vec3 thi = max(t0, t1);
        float tn = max(max(tlo.x, tlo.y), tlo.z);
        float tf = min(min(thi.x, thi.y), thi.z);
        if (tn > tf || tf <= EPS) return false;
        float tt = tn > EPS ? tn : tf;
        if (tt >= tmax) return false;
        t = tt;
        vec3 lp = o + d * tt;
        vec3 q = abs(lp / hext);
        vec3 ln = (q.x > q.y && q.x > q.z) ? vec3(sign(lp.x), 0, 0) : (q.y > q.z ? vec3(0, sign(lp.y), 0) : vec3(0, 0, sign(lp.z)));
        n = ax * ln.x + ay * ln.y + az * ln.z;
        vec3 gap = hext - abs(lp);
        int near_faces = int(gap.x < band) + int(gap.y < band) + int(gap.z < band);
        edge = near_faces >= 2;
        return true;
    }

    float cg_triangle(Ray ray, vec3 a, vec3 b, vec3 c) {
        vec3 e1 = b - a;
        vec3 e2 = c - a;
        vec3 h = cross(ray.direction, e2);
        float det = dot(e1, h);
        if (abs(det) < 1e-12) return -1.0;
        float f = 1.0 / det;
        vec3 s = ray.position - a;
        float bu = f * dot(s, h);
        if (bu < 0.0 || bu > 1.0) return -1.0;
        vec3 q = cross(s, e1);
        float bv = f * dot(ray.direction, q);
        if (bv < 0.0 || bu + bv > 1.0) return -1.0;
        float t = f * dot(e2, q);
        return t > EPS ? t : -1.0;
    }

    float cg_segment_distance(vec3 p, vec3 a, vec3 b) {
        vec3 ab = b - a;
        float len2 = dot(ab, ab);
        float h = len2 > 0.0 ? clamp(dot(p - a, ab) / len2, 0.0, 1.0) : 0.0;
        return length(p - a - ab * h);
    }

    void cg_frustum_side(Ray ray, uint id, vec3 n0, vec3 n1, vec3 f0, vec3 f1, float edgew, inout float ts, inout uint ids, inout vec3 ns, inout float tf, inout uint idf) {
        float t = cg_triangle(ray, n0, f0, f1);
        if (distance(n0, n1) > EPS) {
            float t2 = cg_triangle(ray, n0, f1, n1);
            if (t2 > 0.0 && (t < 0.0 || t2 < t)) t = t2;
        }
        if (t < 0.0) return;
        vec3 p = ray.position + ray.direction * t;
        float wpp = edgew * camera_glyph_wpp(p);
        float de = min(min(cg_segment_distance(p, n0, f0), cg_segment_distance(p, n1, f1)),
                       min(cg_segment_distance(p, f0, f1), cg_segment_distance(p, n0, n1)));
        if (de < wpp) {
            if (t < ts) { ts = t; ids = id; ns = -ray.direction; }
        } else if (t < tf) {
            tf = t; idf = id;
        }
    }

    uint trace_camera_glyphs(Ray ray, out float ts, out vec3 ns, out bool sedge, out float tf, out uint idf) {
        ts = FLTMAX; tf = FLTMAX;
        ns = vec3(0, 0, 1);
        sedge = false;
        uint ids = uint(-1);
        idf = uint(-1);
        uint count = min(o_ubo.camera_count, uint(MAX_CAMERA_GLYPHS));
        for (uint i = 0; i < count; i++) {
            if (i == o_ubo.primary_cid) continue;
            CameraGlyph g = load_camera_glyph(i);
            float wpp = camera_glyph_wpp(g.position);

            // body box behind the lens
            vec3 hext = vec3(CAMERA_GLYPH_BODY_W, CAMERA_GLYPH_BODY_H, CAMERA_GLYPH_BODY_D) * wpp;
            float bt; vec3 bn; bool be;
            if (cg_box(ray, g.position + g.w * hext.z, g.u, g.v, g.w, hext, CAMERA_GLYPH_EDGE_PX * wpp, ts, bt, bn, be)) {
                ts = bt; ns = bn; ids = i; sedge = be;
            }

            // frustum
            float depth;
            float hw;
            float hh;
            vec3 nc[4];
            vec3 fc[4];
            vec2 corners[4] = vec2[4](vec2(-1, -1), vec2(1, -1), vec2(1, 1), vec2(-1, 1));
            if (g.ortho) {
                depth = CAMERA_GLYPH_FRUSTUM_PX * wpp;
                hh = CAMERA_GLYPH_ORTHO_HALF * depth;
                hw = hh * g.aspect;
                for (int k = 0; k < 4; k++) {
                    nc[k] = g.position + g.u * (corners[k].x * hw) + g.v * (corners[k].y * hh);
                    fc[k] = nc[k] - g.w * depth;
                }
            } else {
                depth = CAMERA_GLYPH_FRUSTUM_PX * wpp / max(1.0, max(g.tanx, g.tany));
                hw = g.tanx * depth;
                hh = g.tany * depth;
                for (int k = 0; k < 4; k++) {
                    nc[k] = g.position;
                    fc[k] = g.position - g.w * depth + g.u * (corners[k].x * hw) + g.v * (corners[k].y * hh);
                }
            }
            float scratch_ts = ts;
            uint scratch_ids = ids;
            vec3 scratch_ns = ns;
            for (int k = 0; k < 4; k++) {
                int j = (k + 1) % 4;
                cg_frustum_side(ray, i, nc[k], nc[j], fc[k], fc[j], CAMERA_GLYPH_EDGE_PX, scratch_ts, scratch_ids, scratch_ns, tf, idf);
            }
            if (scratch_ts < ts) { ts = scratch_ts; ids = scratch_ids; ns = scratch_ns; sedge = true; }

            // up tick above the far plane
            vec3 farc = g.position - g.w * depth;
            float tb = 0.55 * min(hw, 2.0 * hh);
            vec3 tbase = farc + g.v * (hh + 0.12 * hh + 2.0 * wpp);
            float ut = cg_triangle(ray, tbase - g.u * tb, tbase + g.u * tb, tbase + g.v * (0.8 * tb));
            if (ut > 0.0 && ut < ts) {
                ts = ut; ids = i; sedge = false;
                ns = dot(g.w, ray.direction) > 0.0 ? -g.w : g.w;
            }
        }
        if (dot(ns, ray.direction) > 0.0) ns = -ns;
        return ids != uint(-1) ? ids : idf;
    }

    const vec3 CAMERA_GLYPH_COLOR = vec3(0.78, 0.84, 0.95);

    vec3 camera_glyph_solid_color(Ray ray, vec3 n, bool edge) {
        if (edge) return CAMERA_GLYPH_COLOR;
        float facing = max(dot(n, -ray.direction), 0.0);
        return CAMERA_GLYPH_COLOR * (0.3 + 0.55 * facing);
    }
}

export CutViewport {
    bool cut_viewport(int rx, int ry) {
        if (ubo.viewport.x != 0 &&
            (rx < ceil(((ubo.width - ubo.viewport.x) / 2.0)) ||
            (rx > ceil(((ubo.width + ubo.viewport.x) / 2.0))))) return true;
        if (ubo.viewport.y != 0 &&
            (ry < ceil(((ubo.height - ubo.viewport.y) / 2.0)) ||
            (ry > ceil(((ubo.height + ubo.viewport.y) / 2.0))))) return true;
        return false;
    }
}

export EpsilonOffset {
    const float ORIGIN_BOUND = 1.0 / 32.0;
    const float FLOAT_SCALE = 1.0 / 65536.0;
    const float INT_SCALE = 256.0;
    vec3 epsilon_offset(vec3 p, vec3 n) {
        ivec3 of_i = ivec3(INT_SCALE * n.x, INT_SCALE * n.y, INT_SCALE * n.z);
        vec3 p_i = vec3(
            intBitsToFloat(floatBitsToInt(p.x) + ((p.x < 0.0) ? -of_i.x : of_i.x)),
            intBitsToFloat(floatBitsToInt(p.y) + ((p.y < 0.0) ? -of_i.y : of_i.y)),
            intBitsToFloat(floatBitsToInt(p.z) + ((p.z < 0.0) ? -of_i.z : of_i.z))
        );
        return vec3(
            abs(p.x) < ORIGIN_BOUND ? p.x + FLOAT_SCALE * n.x : p_i.x,
            abs(p.y) < ORIGIN_BOUND ? p.y + FLOAT_SCALE * n.y : p_i.y,
            abs(p.z) < ORIGIN_BOUND ? p.z + FLOAT_SCALE * n.z : p_i.z
        );
    }
}

export TriangleIntersectSuite {
    bool stack_failure = false;
    uint bvh_counter = 0;

    bool triangle_intersect(Ray ray, uint triangle_ind, inout Hit hit) {
        Triangle tri = triangleIn[triangle_ind];
        vec3 _a = vertexIn[tri.a].xyz;
        vec3 _b = vertexIn[tri.b].xyz;
        vec3 _c = vertexIn[tri.c].xyz;
        vec3 e1 = _b - _a;
        vec3 e2 = _c - _a;
        vec3 h = cross(ray.direction, e2);
        float a = dot(e1, h);
        if (abs(a) < EPS) return false;
        float f = 1.0 / a;
        vec3 s = ray.position - _a;
        float u = f*dot(s, h);
        if (u < 0.0 || u > 1.0) return false;
        vec3 q = cross(s, e1);
        float v = f*dot(ray.direction, q);
        if (v < 0.0 || u + v > 1.0) return false;
        hit.distance = f * dot(e2, q);
        if (hit.distance <= EPS) return false;
        hit.material = tri.material;
        hit.position = ray.position + (ray.direction * hit.distance);
        if (ubo.normals != 0 && tri.an != -1) hit.normal = normalize((1.0 - u - v)*normalIn[tri.an] + u*normalIn[tri.bn] + v*normalIn[tri.cn]);
        else hit.normal = normalize(cross(e1, e2));
        if (dot(hit.normal, -ray.direction) < 0.0) hit.normal = -hit.normal;
        return true;
    }

    bool aabb_intersect(Ray ray, uint node_ind) {
    	vec3 dfrac = 1.0 / ray.direction;
        vec3 mindif = (nodeIn[node_ind].minBB - ray.position)*dfrac;
        vec3 maxdif = (nodeIn[node_ind].maxBB - ray.position)*dfrac;
    	float tmin = max(max(min(mindif.x, maxdif.x), min(mindif.y, maxdif.y)), min(mindif.z, maxdif.z));
    	float tmax = min(min(max(mindif.x, maxdif.x), max(mindif.y, maxdif.y)), max(mindif.z, maxdif.z));
        return tmax >= 0 && tmin <= tmax;
    }

    // slab test against the current search interval [0, tfar]; tnear is the entry distance
    bool aabb_near(Ray ray, vec3 inv, uint node_ind, float tfar, out float tnear) {
        vec3 t0 = (nodeIn[node_ind].minBB - ray.position) * inv;
        vec3 t1 = (nodeIn[node_ind].maxBB - ray.position) * inv;
        vec3 tlo = min(t0, t1);
        vec3 thi = max(t0, t1);
        tnear = max(max(tlo.x, tlo.y), max(tlo.z, 0.0));
        return tnear <= min(min(thi.x, thi.y), min(thi.z, tfar));
    }

    Hit trace_max(Ray ray, float tmax, inout uint hit_id) {
        Hit hit;
        hit.distance = -1.0;
        if (ubo.triangles == 0) return hit;
        vec3 d = ray.direction;
        vec3 inv = 1.0 / mix(d, mix(vec3(1e-20), vec3(-1e-20), lessThan(d, vec3(0.0))), lessThan(abs(d), vec3(1e-20)));
        float best = tmax;
        float tn, tl, tr;
        uint stack[MAX_RECURSIVE_DEPTH];
        int stack_ptr = 0;
        if (!aabb_near(ray, inv, 0u, best, tn)) return hit;
        stack[stack_ptr++] = 0u;
        while (stack_ptr > 0) {
            bvh_counter++;
            uint node_index = stack[--stack_ptr];
            if (!aabb_near(ray, inv, node_index, best, tn)) continue; // a closer hit was found after it was pushed
            BVHNode node = nodeIn[node_index];
            if (node.right == 0xFFFFFFFF) {
                Hit trihit;
                if (triangle_intersect(ray, node.left, trihit) && trihit.distance < best) {
                    best = trihit.distance;
                    hit = trihit;
                    hit_id = node.left;
                }
                continue;
            }
            if (stack_ptr >= MAX_RECURSIVE_DEPTH - 2) { stack_failure = true; break; }
            bool hl = aabb_near(ray, inv, node.left, best, tl);
            bool hr = aabb_near(ray, inv, node.right, best, tr);
            if (hl && hr) {
                // push the farther child first so the nearer one is popped next
                if (tl <= tr) { stack[stack_ptr++] = node.right; stack[stack_ptr++] = node.left; }
                else { stack[stack_ptr++] = node.left; stack[stack_ptr++] = node.right; }
            } else if (hl) {
                stack[stack_ptr++] = node.left;
            } else if (hr) {
                stack[stack_ptr++] = node.right;
            }
        }
        return hit;
    }

    Hit trace(Ray ray, inout uint hit_id) {
        return trace_max(ray, FLTMAX, hit_id);
    }
}

export QuatToMat {
    mat3 quat_to_mat3(vec4 q) {
        float w = q.x;
        float x = q.y;
        float y = q.z;
        float z = q.w;
        return transpose(mat3(
            1.0 - 2.0 * (y * y + z * z),
            2.0 * (x * y - z * w),
            2.0 * (x * z + y * w),
            2.0 * (x * y + z * w),
            1.0 - 2.0 * (x * x + z * z),
            2.0 * (y * z - x * w),
            2.0 * (x * z - y * w),
            2.0 * (y * z + x * w),
            1.0 - 2.0 * (x * x + y * y)
        ));
    }
}

export SplatConstants {
    const float SPLAT_SIGMA = 3.0; // support radius in std-devs
    const float SPLAT_DENSITY = 1.0; // global extinction multiplier
    const float SPLAT_G = 0.0; // Henyey-Greenstein anisotropy of the phase function (-1..1)
    const float VOLUME_TFAR = 1e30;
    const float SPLAT_OCCLUSION_ALPHA = 0.3; // effective opacity at which a splat blocks surface shadow rays
    const float SQRT_2PI = 2.50662827463;
}

export TrainerSuite {
    #define PSTRIDE 16 // floats per gaussian in params / grads / adam buffers
    #define GSTRIDE 16 // floats per gaussian in the projected geometry buffer
    #define RSTRIDE 12 // floats per gaussian in the raster gradient scratch buffer
    #define SH_C0 0.28209479177387814
    #define TILE 16
    #define BLOCK 256
    #define SORT_GROUPS 256
    #define SORT_RADIX 16
    #define SCAN_BLOCK 2048
    #define LOW_PASS 0.3
    #define MIN_ALPHA (1.0 / 255.0)
    #define MAX_ALPHA 0.99
    #define T_EPSILON 0.0001

    // params layout (per gaussian, PSTRIDE floats)
    #define P_POS 0
    #define P_SCALE 3
    #define P_QUAT 6
    #define P_OPAC 10
    #define P_COLOR 11

    // projected geometry layout (per gaussian, GSTRIDE floats)
    #define G_MEAN 0 // xy, pixel space
    #define G_CONIC 2 // xyz = (A, B, C)
    #define G_OPAC 5 // sigmoid(opacity)
    #define G_COLOR 6 // rgb
    #define G_DEPTH 9
    #define G_RADIUS 10
    #define G_RECT 12 // uvec4 tile rect (minx, miny, maxx, maxy) stored as uint bits

    // binding slots
    #define B_PARAMS 0
    #define B_GRADS 1
    #define B_ADAM_M 2
    #define B_ADAM_V 3
    #define B_GEOM 4
    #define B_COUNTS 5
    #define B_OFFSETS 6
    #define B_BLOCKS 7
    #define B_KEYS_A 8
    #define B_VALS_A 9
    #define B_KEYS_B 10
    #define B_VALS_B 11
    #define B_SORT_HIST 12
    #define B_RANGES 13
    #define B_META 14
    #define B_RENDER 15
    #define B_NCONTRIB 16
    #define B_GT 17
    #define B_DLDPIX 18
    #define B_SSIM 19
    #define B_GRAD2D 20
    #define B_DENS 21
    #define B_ACTIONS 22
    #define B_LOSS 23

    #define BUF(slot, name, type, qual) layout(std430, set = 0, binding = slot) qual buffer Buf_##name { type name[]; }

    // meta buffer slots
    #define META_TOTAL 0 // raw (unclamped) tile/gaussian pair count
    #define META_PAIRS 1 // clamped pair count actually stored
    #define META_INDIRECT 8 // 3 uints, dispatch args for pair sized kernels

    // push constants shared by the render pipeline kernels
    layout(push_constant) uniform PC {
        vec4 eye_d; // eye.xyz, focal length in pixels
        vec4 right_cx; // camera right axis, principal point x
        vec4 down_cy; // camera down axis, principal point y
        vec4 fwd_near; // camera forward axis, near plane
        uvec4 dims; // width, height, tiles x, tiles y
        uvec4 cnt; // gaussian count, pair capacity, view index, sort shift | (direction << 16)
        vec4 bgl; // background rgb, lambda ssim
        vec4 dr; // depth min, depth scale (65535 / range), unused, unused
    } pc;

    // quaternion (w, x, y, z), will be normalized
    mat3 quat_to_rot(vec4 q) {
        float n = inversesqrt(max(dot(q, q), 1e-24));
        float w = q.x * n, x = q.y * n, y = q.z * n, z = q.w * n;
        return mat3(
            1.0 - 2.0 * (y * y + z * z), 2.0 * (x * y + w * z), 2.0 * (x * z - w * y),
            2.0 * (x * y - w * z), 1.0 - 2.0 * (x * x + z * z), 2.0 * (y * z + w * x),
            2.0 * (x * z + w * y), 2.0 * (y * z - w * x), 1.0 - 2.0 * (x * x + y * y));
    }

    float sigmoidf(float x) { return 1.0 / (1.0 + exp(-x)); }

    // Camera derived quantities shared by the projection forward / backward kernels.
    struct Cam {
        vec3 eye, right, down, fwd;
        float d, cx, cy, near, limx, limy;
    };

    Cam load_cam() {
        Cam c;
        c.eye = pc.eye_d.xyz;
        c.d = pc.eye_d.w;
        c.right = pc.right_cx.xyz;
        c.cx = pc.right_cx.w;
        c.down = pc.down_cy.xyz;
        c.cy = pc.down_cy.w;
        c.fwd = pc.fwd_near.xyz;
        c.near = pc.fwd_near.w;
        float W = float(pc.dims.x), H = float(pc.dims.y);
        c.limx = 1.3 * max(c.cx, W - c.cx) / c.d;
        c.limy = 1.3 * max(c.cy, H - c.cy) / c.d;
        return c;
    }

    // EWA splatting projection of a 3D gaussian, shared by the forward and backward kernels so that the
    // two always agree. Requires train_common.glsl.

    struct Proj {
        vec3 t; // camera space position (x right, y down, z forward)
        vec3 s; // exp(logscale)
        mat3 R; // rotation, R[col][row]
        mat3 M; // R * diag(s)
        mat3 Sigma; // M * M^T
        vec3 T0, T1; // rows of J * W expressed in world space
        float a, b, c; // 2D covariance (with low pass filter)
        float det;
        float clx, cly; // clamped t.x / t.z, t.y / t.z
        bool clampx, clampy;
        vec2 mean2d;
    };

    // returns false when the gaussian cannot be rasterized from this camera
    bool project_gaussian(Cam cam, vec3 mean, vec3 logscale, vec4 q, out Proj p) {
        vec3 rel = mean - cam.eye;
        p.t = vec3(dot(rel, cam.right), dot(rel, cam.down), dot(rel, cam.fwd));
        p.s = exp(logscale);
        p.R = quat_to_rot(q);
        p.M = mat3(p.R[0] * p.s.x, p.R[1] * p.s.y, p.R[2] * p.s.z);
        p.Sigma = p.M * transpose(p.M);
        p.mean2d = vec2(0.0);
        p.T0 = vec3(0.0); p.T1 = vec3(0.0);
        p.a = 0.0; p.b = 0.0; p.c = 0.0; p.det = 0.0;
        p.clx = 0.0; p.cly = 0.0; p.clampx = false; p.clampy = false;
        if (p.t.z <= cam.near) return false;
        float tx = p.t.x / p.t.z;
        float ty = p.t.y / p.t.z;
        p.clampx = tx < -cam.limx || tx > cam.limx;
        p.clampy = ty < -cam.limy || ty > cam.limy;
        p.clx = clamp(tx, -cam.limx, cam.limx);
        p.cly = clamp(ty, -cam.limy, cam.limy);
        float j00 = cam.d / p.t.z;
        float j02 = -cam.d * p.clx / p.t.z;
        float j11 = cam.d / p.t.z;
        float j12 = -cam.d * p.cly / p.t.z;
        p.T0 = j00 * cam.right + j02 * cam.fwd;
        p.T1 = j11 * cam.down + j12 * cam.fwd;
        vec3 sT0 = p.Sigma * p.T0;
        vec3 sT1 = p.Sigma * p.T1;
        p.a = dot(p.T0, sT0) + LOW_PASS;
        p.b = dot(p.T0, sT1);
        p.c = dot(p.T1, sT1) + LOW_PASS;
        p.det = p.a * p.c - p.b * p.b;
        p.mean2d = vec2(cam.d * p.t.x / p.t.z + cam.cx, cam.d * p.t.y / p.t.z + cam.cy);
        return p.det > 0.0;
    }
}

export RandomSuite {
    // pcg4d stream shared by every shader that samples: path.comp seeds it per pixel, sss_train.comp per work item
    uvec4 seed = uvec4(0);

    void pcg4d(inout uvec4 v) {
        v = v * 1664525u + 1013904223u;
        v.x += v.y * v.w;
        v.y += v.z * v.x;
        v.z += v.x * v.y;
        v.w += v.y * v.z;
        v = v ^ (v >> 16u);
        v.x += v.y * v.w;
        v.y += v.z * v.x;
        v.z += v.x * v.y;
        v.w += v.y * v.z;
    }

    float random() {
        pcg4d(seed);
        return float(seed.x) / float(0xffffffffu);
    }
}

export SamplingSuite {
    vec3 onb(vec3 normal, vec3 local) {
        vec3 w = normal;
        vec3 a = (abs(w.x) > 0.9) ? vec3(0, 1, 0) : vec3(1, 0, 0);
        vec3 v = normalize(cross(w, a));
        vec3 u = normalize(cross(w, v));
        return normalize(local.x * u + local.y * v + local.z * w);
    }

    vec3 sample_cosine_weighted_lobe() {
        float r1 = random();
        float r2 = random();
        float sqr2 = sqrt(r2);
        float phi = 2.0 * PI * r1;
        return vec3(cos(phi) * sqr2, sin(phi) * sqr2, sqrt(1.0 - r2));
    }

    vec3 sample_henyey_greenstein(vec3 outgoing, float g) {
        float xi1 = random();
        float xi2 = random();
        float cos_theta = 0.0;
        if (abs(g) < 0.001) {
            cos_theta = 1.0 - 2.0 * xi1;
        } else {
            float sqr = (1.0 - g * g) / (1.0 - g + 2.0 * g * xi1);
            cos_theta = (1.0 + g * g - sqr * sqr) / (2.0 * g);
            cos_theta = clamp(cos_theta, -1.0, 1.0);
        }
        float sin_theta = sqrt(max(0.0, 1.0 - cos_theta * cos_theta));
        float phi = 2.0 * PI * xi2;
        vec3 local = vec3(sin_theta * cos(phi), sin_theta * sin(phi), cos_theta);
        return onb(outgoing, local);
    }

    vec3 safe_inverse(vec3 d) {
        return 1.0 / mix(d, vec3(1e-20), lessThan(abs(d), vec3(1e-20)));
    }

    float erf_approx(float x) { // Abramowitz & Stegun 7.1.26, abs error < 1.5e-7
        float s = sign(x);
        x = abs(x);
        float t = 1.0 / (1.0 + 0.3275911 * x);
        float y = 1.0 - (((((1.061405429 * t - 1.453152027) * t) + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t * exp(-x * x);
        return s * y;
    }

    float normal_cdf(float x) {
        return 0.5 * (1.0 + erf_approx(x * 0.70710678));
    }

    float erfinv_approx(float x) { // M. Giles, single precision
        float w = -log((1.0 - x) * (1.0 + x));
        float p;
        if (w < 5.0) {
            w = w - 2.5;
            p = 2.81022636e-08;
            p = 3.43273939e-07 + p * w;
            p = -3.5233877e-06 + p * w;
            p = -4.39150654e-06 + p * w;
            p = 0.00021858087 + p * w;
            p = -0.00125372503 + p * w;
            p = -0.00417768164 + p * w;
            p = 0.246640727 + p * w;
            p = 1.50140941 + p * w;
        } else {
            w = sqrt(w) - 3.0;
            p = -0.000200214257;
            p = 0.000100950558 + p * w;
            p = 0.00134934322 + p * w;
            p = -0.00367342844 + p * w;
            p = 0.00573950773 + p * w;
            p = -0.0076224613 + p * w;
            p = 0.00943887047 + p * w;
            p = 1.00167406 + p * w;
            p = 2.83297682 + p * w;
        }
        return p * x;
    }

    float normal_quantile(float p) {
        p = clamp(p, 1e-7, 1.0 - 1e-7);
        return 1.41421356 * erfinv_approx(2.0 * p - 1.0);
    }
}

export SubsurfaceSuite {
    // Blob layout (uint words, floats as raw bits; offsets relative to the blob's base). Header words:
    //   2 triangle count, 3 table, 4 surface gaussians, 5 count, 6 lobes, 7 count, 8 internal gaussians, 9 count,
    //   10 nodes, 11 count, 12 sigma, 13 g, 14 mean free path, 15 excess length floor, 16..22 background path length
    //   coefficients, 23 background weight, 24 point chord length, 25 first triangle, 26 material, 27 trained scale.
    // Records: table 4 words per triangle (3 candidate surface gaussians, flags), surface gaussian 16, lobe 16,
    // internal gaussian 20, node 8 (see the CPU packer in src/renderer/subsurface.c).
    // Define SSS_CHORD_VISIT(i, c) before importing to see every internal gaussian a chord passes (trainer only).

    const uint SSSG_H_TCOUNT = 2u;
    const uint SSSG_H_TABLE = 3u;
    const uint SSSG_H_SURF = 4u;
    const uint SSSG_H_LOBE = 6u;
    const uint SSSG_H_GAUSS = 8u;
    const uint SSSG_H_NODE = 10u;
    const uint SSSG_H_NNODE = 11u;
    const uint SSSG_H_MFP = 14u;
    const uint SSSG_H_EPS = 15u;
    const uint SSSG_H_BG = 16u;
    const uint SSSG_H_BGW = 23u;
    const uint SSSG_H_DMIN = 24u;
    const uint SSSG_TABLE_STRIDE = 4u;
    const uint SSSG_SURF_STRIDE = 16u;
    const uint SSSG_LOBE_STRIDE = 16u;
    const uint SSSG_GAUSS_STRIDE = 20u;
    const uint SSSG_NODE_STRIDE = 8u;
    const uint SSSG_TRI_FLIP = 1u;
    const uint SSSG_LEAF = 0x80000000u;
    const uint SSSG_NONE = 0xFFFFFFFFu;
    const float SSS_GAUSS_CUTOFF = 9.0;
    const int SSS_PROJECTION_TRIES = 3;
    const int SSS_FOREIGN_SKIPS = 4;
    const float SSS_MAX_EXCESS_MFP = 2000.0; // cap on the sampled extra path length (log normal tails are unbounded)
    const int SSS_FLIGHT_SCATTERED = 0;
    const int SSS_FLIGHT_EXITED = 1;
    const int SSS_FLIGHT_ESCAPED = 2;

    struct SSSObject {
        uint base;
        uvec3 bases; // per channel blobs (all equal for a single cloud)
        uint channels;
        uint tstart;
        uint tcount;
        mat4 M; // object -> world
        mat4 Minv;
        mat3 M3;
        float scale; // cube root of |det M3|, converts object space lengths to world space
        float handed; // sign of det M3: mirrored transforms flip triangle winding
    };

    // a cloud evaluated where its object is the whole scene, in object space (the trainer)
    SSSObject sss_object_identity(uint base, uint tcount) {
        SSSObject o;
        o.base = base;
        o.bases = uvec3(base);
        o.channels = 1u;
        o.tstart = 0u;
        o.tcount = tcount;
        o.M = mat4(1.0);
        o.Minv = mat4(1.0);
        o.M3 = mat3(1.0);
        o.scale = 1.0;
        o.handed = 1.0;
        return o;
    }

    float sss_f(uint i) { return uintBitsToFloat(sssIn[i]); }
    vec3 sss_v3(uint i) { return vec3(sss_f(i), sss_f(i + 1u), sss_f(i + 2u)); }
    mat3 sss_m3(uint i) { return mat3(sss_v3(i), sss_v3(i + 3u), sss_v3(i + 6u)); } // column major

    Ray sss_walk_enter(vec3 position, vec3 outside, vec3 incident, float anisotropy) {
        Ray ray;
        ray.direction = sample_henyey_greenstein(incident, anisotropy);
        if (dot(ray.direction, outside) > 0.0) ray.direction = reflect(ray.direction, outside);
        ray.position = epsilon_offset(position, -outside);
        return ray;
    }

    int sss_walk_flight(inout Ray ray, float sigma, float anisotropy, inout uint boundary_id, out float segment, out Hit boundary) {
        segment = 0.0;
        boundary = trace(ray, boundary_id);
        if (boundary.distance <= 0.0) return SSS_FLIGHT_ESCAPED;
        float xi = max(random(), 1e-6);
        float free_distance = -log(1.0 - xi) / sigma;
        if (free_distance >= boundary.distance) {
            segment = boundary.distance;
            ray.position = epsilon_offset(ray.position, ray.direction) + ray.direction * boundary.distance;
            return SSS_FLIGHT_EXITED;
        }
        segment = free_distance;
        // phase function around the travel direction (anisotropy > 0 = forward scattering)
        ray.position += ray.direction * free_distance;
        ray.direction = sample_henyey_greenstein(ray.direction, anisotropy);
        return SSS_FLIGHT_SCATTERED;
    }

    vec3 sss_tri_normal(SSSObject o, uint tid) {
        Triangle tri = triangleIn[tid];
        vec3 n = normalize(cross(vertexIn[tri.b].xyz - vertexIn[tri.a].xyz, vertexIn[tri.c].xyz - vertexIn[tri.a].xyz));
        if ((sssIn[o.base + sssIn[o.base + SSSG_H_TABLE] + (tid - o.tstart) * SSSG_TABLE_STRIDE + 3u] & SSSG_TRI_FLIP) != 0u) n = -n;
        return n * o.handed;
    }

    float sss_surface_weight(uint s, vec3 p) {
        vec3 d = p - sss_v3(s);
        vec3 n = sss_v3(s + 4u);
        float st = sss_f(s + 3u), sn = sss_f(s + 7u);
        float dn = dot(d, n);
        float dt2 = max(dot(d, d) - dn * dn, 0.0);
        return exp(-0.5 * (dt2 / (st * st) + dn * dn / (sn * sn)));
    }

    uint sss_pick_surface(uint base, uint lt, vec3 p, float r) {
        uint row = base + sssIn[base + SSSG_H_TABLE] + lt * SSSG_TABLE_STRIDE;
        uint surf = base + sssIn[base + SSSG_H_SURF];
        float w[3] = float[3](0.0, 0.0, 0.0);
        float total = 0.0;
        for (int k = 0; k < 3; k++) {
            uint id = sssIn[row + uint(k)];
            if (id == SSSG_NONE) continue;
            w[k] = sss_surface_weight(surf + id * SSSG_SURF_STRIDE, p);
            total += w[k];
        }
        if (!(total > 1e-30)) return sssIn[row];
        float x = r * total;
        for (int k = 0; k < 3; k++) {
            uint id = sssIn[row + uint(k)];
            if (id == SSSG_NONE) continue;
            if (x <= w[k]) return id;
            x -= w[k];
        }
        return sssIn[row];
    }

    bool sss_trace_own(SSSObject o, vec3 origin, vec3 dir, float tmax, out float t, out uint tri) {
        t = 0.0;
        tri = 0u;
        float travelled = 0.0;
        Ray r = Ray(origin, dir);
        for (int i = 0; i <= SSS_FOREIGN_SKIPS; i++) {
            uint hid = uint(-1);
            Hit h = trace_max(r, tmax - travelled, hid);
            if (h.distance <= 0.0) return false;
            travelled += h.distance;
            if (hid >= o.tstart && hid < o.tstart + o.tcount) {
                t = travelled;
                tri = hid;
                return true;
            }
            r.position = epsilon_offset(h.position, dir);
        }
        return false;
    }

    float sss_gauss_chord(uint g, vec3 p0, vec3 p1, float D) {
        mat3 W = sss_m3(g + 4u);
        vec3 o = W * (p0 - sss_v3(g));
        vec3 dv = W * (p1 - p0);
        float A = dot(dv, dv);
        float od = dot(o, dv);
        float tc = -od / A;
        float h2 = max(dot(o, o) - od * od / A, 0.0);
        if (h2 > SSS_GAUSS_CUTOFF) return 0.0;
        float sa = sqrt(A);
        float za = -tc * sa, zb = (1.0 - tc) * sa;
        if (zb < -3.0 || za > 3.0) return 0.0;
        return D * exp(-0.5 * h2) * SQRT_2PI / sa * (normal_cdf(zb) - normal_cdf(za));
    }

    float sss_gauss_point(uint g, vec3 p) {
        vec3 o = sss_m3(g + 4u) * (p - sss_v3(g));
        float q = dot(o, o);
        if (q > SSS_GAUSS_CUTOFF) return 0.0;
        return exp(-0.5 * q);
    }

    float sss_cloud_chord(uint base, vec3 p0, vec3 p1, out float C, out float Q[7]) {
        uint gs = base + sssIn[base + SSSG_H_GAUSS];
        uint nodes = base + sssIn[base + SSSG_H_NODE];
        float dmin = sss_f(base + SSSG_H_DMIN);
        vec3 e = p1 - p0;
        float D = length(e);
        bool point = D < dmin;
        float len = point ? dmin : D;
        vec3 inv = safe_inverse(e);
        C = 0.0;
        for (int k = 0; k < 7; k++) Q[k] = 0.0;
        if (sssIn[base + SSSG_H_NNODE] == 0u) return len;
        uint stack[64];
        int sp = 0;
        stack[sp++] = 0u;
        while (sp > 0) {
            uint nd = nodes + stack[--sp] * SSSG_NODE_STRIDE;
            bvh_counter++;
            vec3 bmin = sss_v3(nd), bmax = sss_v3(nd + 4u);
            bool hit;
            if (point) {
                hit = all(greaterThanEqual(p0, bmin)) && all(lessThanEqual(p0, bmax));
            } else {
                vec3 t0 = (bmin - p0) * inv, t1 = (bmax - p0) * inv;
                vec3 tlo = min(t0, t1), thi = max(t0, t1);
                hit = max(max(tlo.x, tlo.y), max(tlo.z, 0.0)) <= min(min(thi.x, thi.y), min(thi.z, 1.0));
            }
            if (!hit) continue;
            uint w7 = sssIn[nd + 7u];
            if ((w7 & SSSG_LEAF) != 0u) {
                uint first = sssIn[nd + 3u], count = w7 & ~SSSG_LEAF;
                for (uint i = first; i < first + count; i++) {
                    uint g = gs + i * SSSG_GAUSS_STRIDE;
                    float c = point ? dmin * sss_gauss_point(g, p0) : sss_gauss_chord(g, p0, p1, D);
                    if (!(c > 0.0)) continue;
                    #ifdef SSS_CHORD_VISIT
                        SSS_CHORD_VISIT(i, c);
                    #endif
                    C += c;
                    for (int k = 0; k < 7; k++) Q[k] += c * sss_f(g + 13u + uint(k));
                }
            } else if (sp < 62) {
                stack[sp++] = sssIn[nd + 3u];
                stack[sp++] = w7;
            }
        }
        return len;
    }

    void sss_length_model(uint base, vec3 p0, vec3 p1, out vec4 comps, out float w1) {
        float C;
        float Q[7];
        float len = sss_cloud_chord(base, p0, p1, C, Q);
        float cbg = sss_f(base + SSSG_H_BGW) * len;
        for (int k = 0; k < 7; k++) Q[k] += cbg * sss_f(base + SSSG_H_BG + uint(k));
        C += cbg;
        float u = log(1.0 + length(p1 - p0) / sss_f(base + SSSG_H_MFP));
        float invC = 1.0 / C;
        comps.x = (Q[0] + u * Q[1]) * invC;
        comps.y = exp(clamp(Q[2] * invC, -6.0, 4.0));
        comps.z = (Q[3] + u * Q[4]) * invC;
        comps.w = exp(clamp(Q[5] * invC, -6.0, 4.0));
        w1 = 1.0 / (1.0 + exp(-clamp(Q[6] * invC, -20.0, 20.0)));
    }

    float sss_dir_pdf(vec3 w, vec3 n, vec3 axis, float e) {
        float wn = dot(w, n);
        if (wn <= 0.0) return 0.0;
        vec3 wr = w - 2.0 * wn * n;
        float norm = (e + 1.0) / (2.0 * PI);
        float c0 = dot(axis, w);
        float c1 = dot(axis, wr);
        e = max(e, 1e-3); // pow(0, 0) is undefined in GLSL
        return norm * ((c0 > 0.0 ? pow(c0, e) : 0.0) + (c1 > 0.0 ? pow(c1, e) : 0.0));
    }

    struct SSSCloudSample {
        vec3 position; // exit point, world space
        vec3 local; // exit point, object space
        uint triangle; // exit triangle
        vec3 normal; // outward normal at the exit, world space
        vec3 direction; // exit direction, world space
        vec3 axis; // exit direction lobe: axis (world space) and cosine power
        float exponent;
        float chord; // entry -> exit distance, object space
        float path_length; // sampled path length, object space
        bool projected; // false when the exit projection failed and the path leaves where it entered
    };

    SSSCloudSample sss_cloud_sample(SSSObject o, uint base, vec3 entry, uint tid) {
        SSSCloudSample s;
        float mfp = sss_f(base + SSSG_H_MFP);
        vec3 p = (o.Minv * vec4(entry, 1.0)).xyz;
        uint lt = tid - o.tstart;
        // 1. surface gaussian under the entry point
        uint sgi = sss_pick_surface(base, lt, p, random());
        uint sg = base + sssIn[base + SSSG_H_SURF] + sgi * SSSG_SURF_STRIDE;
        uint lfirst = sssIn[sg + 12u], lcount = sssIn[sg + 13u];
        uint lobes = base + sssIn[base + SSSG_H_LOBE];
        // 2. + 3. sample an exit lobe and project the sample onto the surface along the lobe axis (redrawn on a miss)
        vec3 xw = entry;
        uint xt = tid;
        bool projected = false;
        for (int attempt = 0; attempt < SSS_PROJECTION_TRIES && !projected; attempt++) {
            float u = random();
            uint li = lfirst;
            for (uint j = 0u; j < lcount; j++) {
                li = lfirst + j;
                if (u <= sss_f(lobes + li * SSSG_LOBE_STRIDE + 3u)) break;
            }
            uint lb = lobes + li * SSSG_LOBE_STRIDE;
            mat3 L = sss_m3(lb + 4u);
            float u1 = max(random(), 1e-7), u2 = random(), u3 = max(random(), 1e-7), u4 = random();
            float r1 = sqrt(-2.0 * log(u1)), r2 = sqrt(-2.0 * log(u3));
            vec3 z = vec3(r1 * cos(2.0 * PI * u2), r1 * sin(2.0 * PI * u2), r2 * cos(2.0 * PI * u4));
            vec3 a = sss_v3(lb + 13u);
            vec3 q = p + sss_v3(lb) + L * z;
            float H = 3.0 * length(transpose(L) * a) + 0.5 * mfp;
            // world space: rigid transforms keep distances up to o.scale
            vec3 aw = normalize(o.M3 * a);
            vec3 qw = (o.M * vec4(q, 1.0)).xyz;
            float Hw = H * o.scale;
            float t;
            uint ht;
            if (sss_trace_own(o, qw + aw * Hw, -aw, 2.0 * Hw, t, ht)) {
                xw = qw + aw * Hw - aw * t;
                xt = ht;
                projected = true;
            } else {
                float best = FLTMAX;
                for (int sgn = 0; sgn < 2; sgn++) {
                    vec3 dd = sgn == 0 ? aw : -aw;
                    if (sss_trace_own(o, qw, dd, Hw, t, ht) && t < best) {
                        best = t;
                        xw = qw + dd * t;
                        xt = ht;
                        projected = true;
                    }
                }
            }
        }
        if (!projected) {
            xw = entry;
            xt = tid;
        }
        vec3 x = (o.Minv * vec4(xw, 1.0)).xyz;
        // 4. path length: ray trace the internal cloud between the entry and the exit point
        vec4 comps;
        float w1;
        sss_length_model(base, p, x, comps, w1);
        float pick = random();
        float zz = pick < w1 ? comps.x + comps.y * normal_quantile(random()) : comps.z + comps.w * normal_quantile(random());
        float D = length(x - p);
        float excess = max(exp(min(zz, log(SSS_MAX_EXCESS_MFP * mfp))) - sss_f(base + SSSG_H_EPS), 0.0);
        // 5. exit direction from the surface gaussian under the exit point
        vec3 n = sss_tri_normal(o, xt);
        uint so = sss_pick_surface(base, xt - o.tstart, x, random());
        uint sgo = base + sssIn[base + SSSG_H_SURF] + so * SSSG_SURF_STRIDE;
        vec3 axis = normalize(o.M3 * sss_v3(sgo + 8u));
        float e = sss_f(sgo + 11u);
        float xi1 = random(), xi2 = random();
        float ct = pow(max(xi1, 1e-7), 1.0 / (e + 1.0));
        float stt = sqrt(max(0.0, 1.0 - ct * ct));
        float phi = 2.0 * PI * xi2;
        vec3 w = onb(axis, vec3(stt * cos(phi), stt * sin(phi), ct));
        float wn = dot(w, n);
        if (wn < 0.0) w -= 2.0 * wn * n;
        s.position = xw;
        s.local = x;
        s.triangle = xt;
        s.normal = n;
        s.direction = w;
        s.axis = axis;
        s.exponent = e;
        s.chord = D;
        s.path_length = D + excess;
        s.projected = projected;
        return s;
    }
}
