#import Boilerplate
#import TrainerSuite

// Finds the [start, end) span of every tile inside the sorted pair list. Dispatched indirectly over
// the pair count. The ranges buffer has to be zeroed beforehand.
BUF(B_KEYS_A, keys, uint, readonly);
BUF(B_RANGES, ranges, uint, );
BUF(B_META, meta, uint, readonly);

void main() {
    uint i = gl_GlobalInvocationID.x;
    uint total = meta[META_PAIRS];
    if (i >= total) return;
    uint tile = keys[i] >> 16;
    if (i == 0u) {
        ranges[tile * 2u] = 0u;
    } else {
        uint prev = keys[i - 1u] >> 16;
        if (prev != tile) {
            ranges[prev * 2u + 1u] = i;
            ranges[tile * 2u] = i;
        }
    }
    if (i == total - 1u) ranges[tile * 2u + 1u] = total;
}
