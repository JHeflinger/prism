#import Boilerplate
#import TrainerSuite

BUF(B_GEOM, geom, float, readonly);
BUF(B_COUNTS, counts, uint, readonly);
BUF(B_OFFSETS, offsets, uint, readonly);
BUF(B_KEYS_A, keys, uint, );
BUF(B_VALS_A, vals, uint, );

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.cnt.x) return;
    if (counts[i] == 0u) return;
    uint g = i * GSTRIDE;
    uvec4 rect = uvec4(
        floatBitsToUint(geom[g + G_RECT]), floatBitsToUint(geom[g + G_RECT + 1]),
        floatBitsToUint(geom[g + G_RECT + 2]), floatBitsToUint(geom[g + G_RECT + 3]));
    float depth = geom[g + G_DEPTH];
    uint dq = uint(clamp((depth - pc.dr.x) * pc.dr.y, 0.0, 65535.0));
    uint off = offsets[i];
    for (uint y = rect.y; y < rect.w; y++) {
        for (uint x = rect.x; x < rect.z; x++) {
            if (off < pc.cnt.y) {
                keys[off] = ((y * pc.dims.z + x) << 16) | dq;
                vals[off] = i;
            }
            off++;
        }
    }
}
