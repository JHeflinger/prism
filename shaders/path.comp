const float max_contribution = 10;
const uint SOBOL_DIRS[2][32] = uint[2][32](
    uint[32](
        0x80000000u, 0x40000000u, 0x20000000u, 0x10000000u,
        0x08000000u, 0x04000000u, 0x02000000u, 0x01000000u,
        0x00800000u, 0x00400000u, 0x00200000u, 0x00100000u,
        0x00080000u, 0x00040000u, 0x00020000u, 0x00010000u,
        0x00008000u, 0x00004000u, 0x00002000u, 0x00001000u,
        0x00000800u, 0x00000400u, 0x00000200u, 0x00000100u,
        0x00000080u, 0x00000040u, 0x00000020u, 0x00000010u,
        0x00000008u, 0x00000004u, 0x00000002u, 0x00000001u),
    uint[32](
        0x80000000u, 0xC0000000u, 0x60000000u, 0x30000000u,
        0x88000000u, 0x44000000u, 0x22000000u, 0x11000000u,
        0x80800000u, 0x40400000u, 0x20200000u, 0x10100000u,
        0x08080000u, 0x04040000u, 0x02020000u, 0x01010000u,
        0x00808000u, 0x00404000u, 0x00202000u, 0x00101000u,
        0x00080800u, 0x00040400u, 0x00020200u, 0x00010100u,
        0x00008080u, 0x00004040u, 0x00002020u, 0x00001010u,
        0x00000808u, 0x00000404u, 0x00000202u, 0x00000101u)
);

uint sobol(uint index, int dimension) {
    uint result = 0u;
    for (int bit = 0; bit < 32; ++bit) {
        if ((index & (1u << bit)) != 0u)
            result ^= SOBOL_DIRS[dimension][bit];
    }
    return result;
}

uint hash(uint x) {
    x ^= x >> 16;
    x *= 0x7feb352du;
    x ^= x >> 15;
    x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}

uint owen_scramble(uint value, uint seed) {
    uint mask = seed;
    for (uint bit = 0u; bit < 32u; ++bit) {
        uint flip = hash(mask) & 1u;
        value ^= flip << bit;
        mask ^= 0x9e3779b9u;
    }
    return value;
}

float sobol_owen(uint index, int dimension, uint seed) {
    uint v = sobol(index, dimension);
    v = owen_scramble(v, seed + uint(dimension) * 0xA511E9B3u);
    return float(v) * (1.0 / 4294967296.0);
}

float fresnel_dielectric(float cosi, float ior_i, float ior_t) {
    cosi = clamp(cosi, -1.0, 1.0);
    bool entering = cosi > 0.0;
    if (!entering) {
        float tmp = ior_i;
        ior_i = ior_t;
        ior_t = tmp;
        cosi *= -1.0;
    }
    float sint = ior_i / ior_t * sqrt(max(0.0, 1.0 - cosi * cosi));
    if (sint >= 1.0) return 1.0; // total internal reflection
    float cost = sqrt(max(0.0, 1.0 - sint * sint));
    float Rs = (ior_t * cosi - ior_i * cost) / (ior_t * cosi + ior_i * cost);
    float Rp = (ior_i * cosi - ior_t * cost) / (ior_i * cosi + ior_t * cost);
    return 0.5 * (Rs * Rs + Rp * Rp);
}

vec3 background_color(Ray ray) {
    return vec3(0.0);
}

float noise(float n) {
	return fract(n*17.0*fract(n*0.3183099));
}

void init_random(int x, int y) {
    seed = uvec4(x, y, ubo.seed, x + y);
}

float luminance(vec3 c) {
    return 0.2126*c.x + 0.7152*c.y + 0.0722*c.z;
}

vec3 beer_lambert(uint material, float dist) {
    return exp(-materialIn[material].absorbtion * dist);
}

Ray create_ray(vec2 rg) {
    uint rayseed = uint(rg.x) * 1973u + uint(rg.y) * 9277u + ubo.samples * 26699u;
    vec2 jitter = vec2(sobol_owen(ubo.samples, 0, rayseed), sobol_owen(ubo.samples, 1, rayseed));
	float r = ubo.width / 2.0;
	float b = ubo.height / 2.0;
	float l = -1.0 * r;
	float t = -1.0 * b;
    float u = l + ((r - l) * (float(rg.x) + jitter.x)) / ubo.width;
    float v = b + ((t - b) * (float(rg.y) + jitter.y)) / ubo.height;
	float d = (cos(ubo.fov / 2.0) / sin(ubo.fov / 2.0)) * r;
    Ray ray;
    if (ubo.ortho != 0u) {
        float world_per_pixel = ubo.orthosize / ubo.height;
        ray.direction = normalize(-ubo.w);
        ray.position = ubo.position + ((ubo.u * u) + (ubo.v * v)) * world_per_pixel;
    } else if (ubo.focus != 0) {
        vec3 pinhole_dir = normalize((ubo.u * u) + (ubo.v * v) - (ubo.w * d));
        vec3 focal_point = ubo.position + pinhole_dir * ubo.focus;
        float r_lens = sqrt(random());
        float theta = 2.0 * 3.14159265 * random();
        vec2 disk = 0.1 * ubo.aperature * vec2(r_lens * cos(theta), r_lens * sin(theta));
        vec3 lens_offset = (ubo.u * disk.x) + (ubo.v * disk.y);
        ray.position = ubo.position + lens_offset;
        ray.direction = normalize(focal_point - ray.position);
    } else {
        ray.direction = normalize((ubo.u * u) + (ubo.v * v) - (ubo.w * d));
        ray.position = ubo.position;
    }
    return ray;
}

float russian_roulette(vec3 throughput) {
    return clamp(max(max(throughput.x, throughput.y), throughput.z), 0.05, 0.999);
}

vec3 sample_specular_phong_lobe(float shiny) {
    float r1 = random();
    float r2 = random();
    float phi = 2.0 * PI * r1;
    float costheta = pow(r2, 1.0 / (shiny + 1.0));
    float sintheta = sqrt(1.0 - costheta * costheta);
    return vec3(cos(phi) * sintheta, sin(phi) * sintheta, costheta);
}

vec3 sample_direct_light_point(inout uint tid, inout float area, inout float pmf) {
    uint i = min(uint(random() * float(ubo.emissives)), ubo.emissives - 1u);
    EmissionAlias e = aliasIn[i];
    uint k = (random() < e.probability) ? i : e.alias;
    pmf = aliasIn[k].pmf;
    tid = emissiveIn[k];
    Triangle tri = triangleIn[tid];
    vec3 _a = vertexIn[tri.a].xyz;
    vec3 _b = vertexIn[tri.b].xyz;
    vec3 _c = vertexIn[tri.c].xyz;
    area = length(cross(_b - _a, _c - _a)) * 0.5;
    float r1 = sqrt(random());
    float r2 = random();
    float u = 1.0 - r1;
    float v = r2 * r1;
    return _a * (1.0 - u - v) + _b * u + _c * v;
}

float diffuse_pdf(vec3 normal, vec3 incoming) {
    return max(0.0, dot(normal, incoming)) / PI;
}

float specular_pdf(vec3 incoming, vec3 R, float shiny) {
    float cosalpha = max(dot(R, incoming), 0.0);
    return (shiny + 1.0) * pow(cosalpha, shiny) / (2.0 * PI);
}

bool refract_ray(vec3 outgoing, vec3 normal, float eta, out vec3 incoming) {
    float cosi = clamp(dot(-outgoing, normal), -1, 1);
    float k = 1.0 - (eta * eta * (1.0 - cosi * cosi));
    if (k < 0.0) return false;
    float cost = sqrt(k);
    incoming = normalize(eta * (outgoing) + ((eta * cosi - cost) * normal));
    return true;
}

vec3 lambertian_throughput(in vec3 outgoing, in vec3 normal, in vec3 incoming, in Material material) {
    return ((material.diffuse / PI) +
        (material.specular * (material.shiny + 2.0) /
        (2.0 * PI) * pow(max(dot(reflect(-outgoing, normal), incoming), 0.0), material.shiny))) *
        max(0.0, dot(incoming, normal));
}

bool aabb_range(Ray ray, vec3 inv, uint node_ind, float tfar, out float tnear) {
    vec3 t0 = (nodeIn[node_ind].minBB - ray.position) * inv;
    vec3 t1 = (nodeIn[node_ind].maxBB - ray.position) * inv;
    vec3 tlo = min(t0, t1);
    vec3 thi = max(t0, t1);
    tnear = max(max(tlo.x, tlo.y), max(tlo.z, 0.0));
    float tf = min(min(thi.x, thi.y), min(thi.z, tfar));
    return tnear <= tf;
}

bool splat_blocks(Ray ray, uint id, float tmax) {
    GaussianSplat g = splatIn[id];
    float alpha = min(1.0 / (1.0 + exp(-g.opacity)), 0.999);
    if (alpha < SPLAT_OCCLUSION_ALPHA) return false;
    vec3 s = max(exp(g.logscale), vec3(1e-4));
    mat3 Rt = transpose(quat_to_mat3(normalize(g.rotation)));
    vec3 o = (Rt * (ray.position - g.position)) / s;
    vec3 d = (Rt * ray.direction) / s;
    float t = clamp(-dot(o, d) / dot(d, d), EPS, tmax);
    vec3 p = o + d * t;
    return dot(p, p) <= 2.0 * log(alpha / SPLAT_OCCLUSION_ALPHA);
}

bool splat_occluded(Ray ray, float tmax) {
    if (ubo.splats == 0 || ubo.splatocclusion == 0) return false;
    tmax = min(tmax, VOLUME_TFAR);
    vec3 inv = safe_inverse(ray.direction);
    uint stack[MAX_RECURSIVE_DEPTH];
    int stack_ptr = 0;
    stack[stack_ptr++] = ubo.triangles * 2;
    while (stack_ptr > 0) {
        uint node_index = stack[--stack_ptr];
        BVHNode node = nodeIn[node_index];
        if (stack_ptr >= MAX_RECURSIVE_DEPTH - 1) { stack_failure = true; break; }
        float tnear;
        if (!aabb_range(ray, inv, node_index, tmax, tnear)) continue;
        if (node.right == 0xFFFFFFFF) {
            if (splat_blocks(ray, node.left, tmax)) return true;
        } else {
            stack[stack_ptr++] = node.left;
            stack[stack_ptr++] = node.right;
        }
    }
    return false;
}

vec3 sample_direct_light(vec3 outgoing, Hit h, Material material) {
    uint eid;
    float area;
    float pmf;
    vec3 pos = sample_direct_light_point(eid, area, pmf);
    if (pmf <= 0.0 || area <= 0.0) return vec3(0.0);
    vec3 to_light = pos - h.position;
    float dist = length(to_light);
    to_light = normalize(to_light);
    Ray sray = { epsilon_offset(h.position, h.normal), to_light };
    uint tid = 0;
    Hit shit = trace(sray, tid);
    if (eid != tid || shit.distance <= 0.0) return vec3(0.0);
    if (splat_occluded(sray, shit.distance)) return vec3(0.0);
    vec3 emission = materialIn[shit.material].emission;
    float p_area = pmf / area;
    float cos_light = max(dot(shit.normal, -to_light), 0.0);
    float p_omega = p_area * dist * dist / cos_light;
    float ks = luminance(material.specular);
    float kd = luminance(material.diffuse);
    float kskd = ks + kd;
    float pd = kd/kskd;
    float ps = ks/kskd;
    return emission * lambertian_throughput(outgoing, h.normal, to_light, material) / (p_omega);
}

vec3 sample_scene_lights(vec3 outgoing, Hit h, Material material) {
    vec3 intensity = vec3(0);
    for (uint i = 0; i < ubo.lights; i++) {
        SceneLight light = lightIn[i];
        vec3 incoming;
        vec3 to_light = light.position - h.position;
        float distance_to_light = length(to_light);
        float falloff = 1.0;
        if (light.angle == 0 && light.direction == vec3(0)) { // point light
            incoming = normalize(to_light);
        } else if (light.angle != 0) { // spot light
            if (light.direction == vec3(0)) light.direction = vec3(0, -1, 0);
            incoming = normalize(to_light);
            float angle = acos(clamp(dot(-incoming, normalize(light.direction)), -1.0, 1.0));
            float lightangle = radians(light.angle / 2.0);
            if (angle > lightangle) continue;
            if (angle > lightangle * (1.0 - light.penumbra)) falloff -= (angle - lightangle * (1.0 - light.penumbra)) / (light.penumbra * lightangle);
        } else { // directional light
            incoming = -normalize(light.direction);
            distance_to_light = FLTMAX;
        }
        float ndotl = max(dot(incoming, h.normal), 0.0);
        if (ndotl <= 0) continue;
        if (ubo.scenelightshadows != 0) {
            Ray sray = { epsilon_offset(h.position, h.normal), incoming };
            uint tid;
            Hit shit = trace(sray, tid);
            if (shit.distance > 0 && shit.distance < distance_to_light) continue;
            if (splat_occluded(sray, distance_to_light)) continue;
        }
        intensity += lambertian_throughput(outgoing, h.normal, incoming, material) * light.color * falloff;
    }
    return intensity;
}

float interpolated_ior(in Material material, in float wavelength) {
    float lambdaR = 610.0;
    float lambdaG = 550.0;
    float lambdaB = 460.0;
    if (wavelength >= lambdaG) {
        return mix(material.dispersion.g, material.dispersion.r, (wavelength - lambdaG) / (lambdaR - lambdaG));
    } else {
        return mix(material.dispersion.b, material.dispersion.g, (wavelength - lambdaB) / (lambdaG - lambdaB));
    }
}

vec3 cheap_wavelength_to_rgb(float lambda) {
    float r = 0.0, g = 0.0, b = 0.0;
    if (lambda >= 380.0 && lambda < 440.0) {
        r = -(lambda - 440.0) / (440.0 - 380.0);
        b = 1.0;
    } else if (lambda < 490.0) {
        g = (lambda - 440.0) / (490.0 - 440.0);
        b = 1.0;
    } else if (lambda < 510.0) {
        g = 1.0;
        b = -(lambda - 510.0) / (510.0 - 490.0);
    } else if (lambda < 580.0) {
        r = (lambda - 510.0) / (580.0 - 510.0);
        g = 1.0;
    } else if (lambda < 645.0) {
        r = 1.0;
        g = -(lambda - 645.0) / (645.0 - 580.0);
    } else if (lambda <= 780.0) {
        r = 1.0;
    }
    float s = 1.0;
    if (lambda > 700.0)
        s = 0.3 + 0.7 * (780.0 - lambda) / (780.0 - 700.0);
    else if (lambda < 420.0)
        s = 0.3 + 0.7 * (lambda - 380.0) / (420.0 - 380.0);
    return vec3(r, g, b) * s;
}

vec3 cheap_spectral_color(in vec3 rgb) {
    float lambdaR = 610.0;
    float lambdaG = 550.0;
    float lambdaB = 460.0;
    return cheap_wavelength_to_rgb(lambdaR) * rgb.r + cheap_wavelength_to_rgb(lambdaG) * rgb.g + cheap_wavelength_to_rgb(lambdaB) * rgb.b;
}

bool sss_spectral(vec3 sigma_t) {
    float hi = max(sigma_t.r, max(sigma_t.g, sigma_t.b));
    float lo = min(sigma_t.r, min(sigma_t.g, sigma_t.b));
    return (hi - lo) > 0.05 * hi;
}

// exited / exit_normal: whether the walk left through the boundary (rather than being cut off by Russian roulette or
// the bounce cap) and the outward geometric normal there
void subsurface_walk(in Ray ray, inout vec3 throughput, inout Hit hit, Material material, inout uint medium, out bool exited, out vec3 exit_normal) {
    exited = false;
    exit_normal = hit.normal;
    // Free flight sampling with one density for all channels: d ~ sigma * exp(-sigma d), sigma = luminance(sigma_t).
    // The sampling density already accounts for transmittance, so the per segment weights are the ratio of the true
    // per channel quantities to it:
    //   scatter at d:          (sigma_s / sigma) * exp(-(sigma_t - sigma) d)
    //   reach the boundary t:  exp(-(sigma_t - sigma) t)     (leaving is not a scattering event, no albedo)
    // For a grey medium this is the textbook walk: albedo per scatter, 1 at the exit. Transport scale multiplies the
    // coefficients themselves (density and attenuation together).
    //
    // Coloured scattering (sigma_t differs across rgb by more than SSS_SPECTRAL_SPREAD, same test as the per channel
    // clouds): a shared density makes the weight of a channel with sigma_s,c > sigma grow by sigma_s,c / sigma > 1 on
    // every scatter, which overflows / gets clamped by max_contribution and loses that channel's energy. Instead one
    // channel is picked per walk and walked at its own sigma_t,c (weights: albedo <= 1 per scatter, 1 at the exit),
    // carrying light in that channel only (x3).
    throughput = vec3(1.0);
    vec3 sigma_s = material.scattering * material.scale;
    vec3 sigma_a = material.absorbtion * material.scale;
    vec3 sigma_t = sigma_s + sigma_a;
    float sigma = max(luminance(sigma_t), EPS);
    int channel = -1;
    if (sss_spectral(sigma_t)) {
        channel = min(int(random() * 3.0), 2);
        sigma = max(sigma_t[channel], EPS);
        throughput = vec3(0.0);
        throughput[channel] = 3.0;
    }
    vec3 sigma_mul = sigma_s / sigma;
    uint boundary_id = uint(-1);
    medium = hit.material;
    for (int bounce = 0; bounce < ubo.maxsssbounces; ++bounce) {
        float segment;
        Hit boundary;
        int flight = sss_walk_flight(ray, sigma, material.anisotropy, boundary_id, segment, boundary);
        if (flight == SSS_FLIGHT_ESCAPED) { // escaped through a crack (or started outside): no valid exit
            throughput = vec3(0.0);
            break;
        }
        if (flight == SSS_FLIGHT_EXITED) {
            if (channel < 0) throughput *= exp(-(sigma_t - sigma) * segment);
            exited = true;
            exit_normal = -boundary.normal; // trace() faces the normal towards the ray origin, which is inside
            //medium = AIR_MEDIUM; // TODO: this should not exactly be air medium, but the previous participating medium
                                 // might need to edit material here to prev material?
            break;
        }
        if (channel < 0) throughput *= exp(-(sigma_t - sigma) * segment) * sigma_mul;
        else throughput[channel] *= sigma_mul[channel];
        float p = russian_roulette(throughput);
        if (random() > p) break; // TODO: how to propogate this termination?
        throughput /= p;
    }
    hit.normal = ray.direction;
    hit.position = ray.position;
}

void sample_lambertian(vec3 outgoing, Hit h, Material material, out vec3 incoming, out float pdf, out vec3 throughput) {
    float ks = luminance(material.specular);
    float kd = luminance(material.diffuse);
    float kskd = ks + kd;
    float pd = kd/kskd;
    float ps = ks/kskd;
    vec3 R = reflect(-outgoing, h.normal);
    incoming = random() < pd ? onb(h.normal, sample_cosine_weighted_lobe()) : onb(R, sample_specular_phong_lobe(material.shiny));
    throughput = 
        ((material.diffuse / PI) +
        (material.specular * (material.shiny + 2.0) /
        (2.0 * PI) * pow(max(dot(R, incoming), 0.0), material.shiny))) *
        max(0.0, dot(incoming, h.normal));
    pdf = (pd * diffuse_pdf(h.normal, incoming) + ps * specular_pdf(incoming, R, material.shiny));
}

// ---------------------------------------------------------------------------------------------------------------------
// Subsurface gaussian clouds ("SSS splats"). Training: src/renderer/subsurface.c with shaders/sss_train.comp; the cloud
// sampler and the random walk's flight are shared with the trainer through SubsurfaceSuite in shared.import. Layout of
// SubsurfaceSSBOIn:
//   [0] object count, [4 + 8k] per object: blob base per colour channel (r, g, b; equal for a single cloud), mesh
//   descriptor, enabled, first triangle, channel count (1 or 3), 0; then the blobs.
// ---------------------------------------------------------------------------------------------------------------------

// state handed from brdf() to pathtrace() for next event estimation at the exit point
bool g_sss_exit = false;
bool g_sss_projected = false;
// debug views: method of the first subsurface event (1 cloud, 2 random walk, 3 cloud but projection failed) and the
// BVH nodes visited inside subsurface handling over the whole path
uint g_sss_debug_kind = 0u;
uint g_sss_debug_cost = 0u;
vec3 g_sss_exit_pos = vec3(0.0);
vec3 g_sss_exit_normal = vec3(0.0, 0.0, 1.0);
vec3 g_sss_exit_axis = vec3(0.0, 0.0, 1.0);
float g_sss_exit_exponent = 1.0;

bool sss_find_object(uint tid, out SSSObject o) {
    o.base = 0u;
    uint n = sssIn[0];
    for (uint k = 0u; k < n; k++) {
        uint e = 4u + 8u * k;
        if (sssIn[e + 4u] == 0u) continue;
        uint base = sssIn[e];
        uint tstart = sssIn[e + 5u];
        uint tcount = sssIn[base + SSSG_H_TCOUNT];
        if (tid < tstart || tid >= tstart + tcount) continue;
        MeshDescriptor md = transformsIn[sssIn[e + 3u]];
        // the cloud is only valid for the exact triangle range it was trained on
        if (md.disabled != 0u || md.tstart != tstart || md.tend == uint(-1) || md.tend - md.tstart + 1u != tcount) continue;
        o.base = base;
        o.bases = uvec3(sssIn[e], sssIn[e + 1u], sssIn[e + 2u]);
        o.channels = sssIn[e + 6u];
        o.tstart = tstart;
        o.tcount = tcount;
        o.M = md.transform;
        o.Minv = inverse(md.transform);
        o.M3 = mat3(md.transform);
        float det = determinant(o.M3);
        o.scale = max(pow(abs(det), 1.0 / 3.0), 1e-8);
        o.handed = det < 0.0 ? -1.0 : 1.0;
        return true;
    }
    return false;
}

// Replaces subsurface_walk(): entry hit h on triangle tid -> exit point (h.position), outward normal (h.normal), exit
// direction and the path's throughput. Returns false when the triangle has no usable cloud.
bool sss_splat_scatter(inout Hit h, uint tid, Material material, out vec3 throughput, out vec3 direction) {
    throughput = vec3(0.0);
    direction = h.normal;
    SSSObject o;
    if (!sss_find_object(tid, o)) return false;
    // Coloured scattering: one cloud per channel, each trained at that channel's own extinction. Pick a channel
    // uniformly; the path then carries light in that channel only (x3), so every channel follows its own transport.
    int channel = -1;
    if (o.channels == 3u) {
        channel = min(int(random() * 3.0), 2);
        o.base = o.bases[channel];
    }
    SSSCloudSample s = sss_cloud_sample(o, o.base, h.position, tid);
    float Lw = s.path_length * o.scale;
    // Throughput: the walk weighs (sigma_s / sigma) per scatter and exp(-(sigma_t - sigma) d) per unit length. With
    // the scatter count along a path of length L treated as poisson(sigma L), its expectation is
    // exp(-(sigma (1 - a) + sigma_t - sigma) L) = exp(-(sigma_t - sigma_s) L) = exp(-sigma_a L), i.e. plain absorption
    // over the sampled path length. The cloud's path lengths are for the shared density sigma; a channel whose
    // sigma_t differs scatters on its own length scale, so (similarity: the same number of mean free paths) its
    // physical length is L * sigma / sigma_t,c. Without this, coloured scattering shifts hue (e.g. green dominant
    // scattering turns purple, because red and blue absorb over too short a distance).
    vec3 sigma_a = material.absorbtion * material.scale;
    if (channel >= 0) {
        // the channel's own cloud: its path lengths are already in that channel's physics, and with poisson(sigma_t,c L)
        // scatters the walk's expected weight is exactly exp(-sigma_a,c L)
        throughput = vec3(0.0);
        throughput[channel] = 3.0 * exp(-sigma_a[channel] * Lw);
    } else {
        vec3 sigma_tc = max((material.scattering + material.absorbtion) * material.scale, vec3(EPS));
        float sigma_shared = max(luminance(sigma_tc), EPS);
        throughput = exp(-sigma_a * (sigma_shared / sigma_tc) * Lw);
    }
    direction = s.direction;
    h.position = s.position;
    h.normal = s.normal;
    g_sss_exit = true;
    g_sss_projected = s.projected;
    g_sss_exit_pos = s.position;
    g_sss_exit_normal = s.normal;
    g_sss_exit_axis = s.axis;
    g_sss_exit_exponent = s.exponent;
    return true;
}

// next event estimation at the exit point (scene lights), with the exit direction density as the "BSDF"
vec3 sss_exit_scene_lights(vec3 pos, vec3 n, vec3 axis, float e) {
    vec3 intensity = vec3(0);
    for (uint i = 0; i < ubo.lights; i++) {
        SceneLight light = lightIn[i];
        vec3 incoming;
        vec3 to_light = light.position - pos;
        float distance_to_light = length(to_light);
        float falloff = 1.0;
        if (light.angle == 0 && light.direction == vec3(0)) { // point light
            incoming = normalize(to_light);
        } else if (light.angle != 0) { // spot light
            if (light.direction == vec3(0)) light.direction = vec3(0, -1, 0);
            incoming = normalize(to_light);
            float angle = acos(clamp(dot(-incoming, normalize(light.direction)), -1.0, 1.0));
            float lightangle = radians(light.angle / 2.0);
            if (angle > lightangle) continue;
            if (angle > lightangle * (1.0 - light.penumbra)) falloff -= (angle - lightangle * (1.0 - light.penumbra)) / (light.penumbra * lightangle);
        } else { // directional light
            incoming = -normalize(light.direction);
            distance_to_light = FLTMAX;
        }
        float pdf = sss_dir_pdf(incoming, n, axis, e);
        if (pdf <= 0.0) continue;
        if (ubo.scenelightshadows != 0) {
            Ray sray = { epsilon_offset(pos, n), incoming };
            uint tid;
            Hit shit = trace_bounded(sray, distance_to_light, tid);
            if (shit.distance > 0) continue;
            if (splat_occluded(sray, distance_to_light)) continue;
        }
        intensity += pdf * light.color * falloff;
    }
    return intensity;
}

// next event estimation at the exit point (emissive triangles)
vec3 sss_exit_direct(vec3 pos, vec3 n, vec3 axis, float e) {
    uint eid;
    float area;
    float pmf;
    vec3 lpos = sample_direct_light_point(eid, area, pmf);
    if (pmf <= 0.0 || area <= 0.0) return vec3(0.0);
    vec3 to_light = lpos - pos;
    float dist = length(to_light);
    to_light = normalize(to_light);
    float pdf = sss_dir_pdf(to_light, n, axis, e);
    if (pdf <= 0.0) return vec3(0.0);
    Ray sray = { epsilon_offset(pos, n), to_light };
    uint tid = 0;
    Hit shit = trace_bounded(sray, dist * 1.001 + 1e-4, tid);
    if (eid != tid || shit.distance <= 0.0) return vec3(0.0);
    if (splat_occluded(sray, shit.distance)) return vec3(0.0);
    float cos_light = max(dot(shit.normal, -to_light), 0.0);
    if (cos_light <= 0.0) return vec3(0.0);
    float p_omega = (pmf / area) * dist * dist / cos_light;
    return materialIn[shit.material].emission * pdf / p_omega;
}

void brdf(in vec3 outgoing, in vec3 previous, inout Hit h, in uint tid, in Material material, out vec3 incoming, out float pdf, out vec3 throughput, inout float ior, inout uint medium, inout float wavelength) {
    switch (material.model) {
        case LAMBERTIAN_MODEL:
            sample_lambertian(outgoing, h, material, incoming, pdf, throughput);
            break;
        case MIRROR_MODEL:
            incoming = reflect(-outgoing, h.normal);
            throughput = material.specular;
            pdf = 1.0;
            break;
        case DIELECTRIC_MODEL:
            float cosi = dot(outgoing, h.normal);
            float eta_i = ior;
            float eta_t = material.ior;
            float pdf_mod = 1.0;
            uint mat_t = h.material;
            vec3 absorb = beer_lambert(medium, length(previous - h.position));
            vec3 wavemask = vec3(1.0);
            if (wavelength < 0 && material.dispersion != vec3(0)) {
                wavelength = mix(380.0, 780.0, random());
                pdf_mod = 1.0 / (780.0 - 380.0);
                wavemask = cheap_wavelength_to_rgb(wavelength);
            }
            if (wavelength >= 0 && material.dispersion != vec3(0)) eta_t *= interpolated_ior(material, wavelength);
            if (medium == mat_t) {
                eta_t = 1.0;
                mat_t = -1;
            }
            float F = fresnel_dielectric(cosi, eta_i, eta_t);
            if (random() < F) {
                incoming = reflect(-outgoing, h.normal);
                throughput = vec3(F) * absorb * wavemask;
                pdf = F * pdf_mod;
            } else {
                float eta = (cosi > 0.0) ? eta_i / eta_t : eta_t / eta_i;
                vec3 Nt = (cosi > 0.0) ? h.normal : -h.normal;
                if (!refract_ray(-outgoing, Nt, eta, incoming)) {
                    incoming = reflect(-outgoing, h.normal);
                    throughput = vec3(1.0) * absorb * wavemask;
                    pdf = F * pdf_mod;
                    return;
                }
                throughput = vec3(1.0 - F) * absorb * wavemask;
                pdf = (1.0 - F) * pdf_mod;
                ior = eta_t;
                medium = mat_t;
            }
            break;
        case SUBSURFACE_MODEL:
            float p_sss = material.subsurface;
            float p_surface = 1.0 - p_sss;
            if (random() <= p_sss) {
                uint cost_before = bvh_counter;
                if (ubo.sssplats != 0u && sss_splat_scatter(h, tid, material, throughput, incoming)) {
                    // trained subsurface cloud: exit point, path length and exit direction in a handful of lookups
                    throughput /= p_sss;
                    pdf = 1.0;
                    g_sss_debug_cost += bvh_counter - cost_before;
                    if (g_sss_debug_kind == 0u) g_sss_debug_kind = g_sss_projected ? 1u : 3u;
                    break;
                }
                // enter along the incident direction (h.normal faces the viewer, so the medium is on -h.normal);
                // a phase sample that points back out is mirrored into the medium
                Ray ray = sss_walk_enter(h.position, h.normal, -outgoing, material.anisotropy);
                bool exited;
                vec3 exit_normal;
                subsurface_walk(ray, throughput, h, material, medium, exited, exit_normal);
                g_sss_debug_cost += bvh_counter - cost_before;
                if (g_sss_debug_kind == 0u) g_sss_debug_kind = 2u;
                throughput /= p_sss;
                incoming = h.normal;
                pdf = 1.0;
                if (exited && ubo.sssexitlight != 0u) {
                    // Diffuse exit (as in Cycles' random walk): keep the walk's exit point but replace its last direction by
                    // a cosine sample around the outward normal, so the exit has a known lobe (cos / pi) and pathtrace() can
                    // sample lights there. Weight stays 1: lobe value / sampling pdf. An approximation of the walk's true
                    // exit direction distribution, which is close to lambertian in dense media.
                    incoming = onb(exit_normal, sample_cosine_weighted_lobe());
                    h.normal = exit_normal;
                    g_sss_exit = true;
                    g_sss_exit_pos = h.position;
                    g_sss_exit_normal = exit_normal;
                    g_sss_exit_axis = exit_normal; // folded cos^1 lobe around the normal == cos / pi
                    g_sss_exit_exponent = 1.0;
                }
            } else {
                sample_lambertian(outgoing, h, material, incoming, pdf, throughput);
                throughput /= p_surface;
            }
            break;
        default: break;
    }
}

vec3 splat_albedo(uint id) {
    return clamp(0.5 + 0.28209479177387814 * splatIn[id].shdc, vec3(0.0), vec3(1.0));
}

bool gaussian_chord(Ray ray, uint id, float tmax, out GaussChord ch) {
    GaussianSplat g = splatIn[id];
    float alpha = min(1.0 / (1.0 + exp(-g.opacity)), 0.999);
    vec3 s = max(exp(g.logscale), vec3(1e-4));
    mat3 Rt = transpose(quat_to_mat3(normalize(g.rotation)));
    vec3 o = (Rt * (ray.position - g.position)) / s;
    vec3 d = (Rt * ray.direction) / s;
    float A = dot(d, d);
    float tc = -dot(o, d) / A;
    vec3 oxd = cross(o, d);
    float h2 = dot(oxd, oxd) / A;
    float S2 = SPLAT_SIGMA * SPLAT_SIGMA;
    if (!(h2 < S2)) return false;
    float sd = inversesqrt(A);
    float zmax = sqrt(S2 - h2);
    float za = max(-zmax, (EPS - tc) / sd);
    float zb = min(zmax, (tmax - tc) / sd);
    if (!(za < zb)) return false;
    float smin = min(s.x, min(s.y, s.z));
    float kappa = SPLAT_DENSITY * -log(1.0 - alpha) / (SQRT_2PI * smin);
    ch.tc = tc;
    ch.sd = sd;
    ch.za = za;
    ch.zb = zb;
    ch.c = kappa * exp(-0.5 * h2) * sd * SQRT_2PI;
    return true;
}

bool sample_gaussian_event(Ray ray, uint id, float tmax, out float t_event) {
    GaussChord ch;
    if (!gaussian_chord(ray, id, tmax, ch)) return false;
    float Pa = normal_cdf(ch.za);
    float Pb = normal_cdf(ch.zb);
    float E = -log(max(1.0 - random(), 1e-12));
    if (E >= ch.c * (Pb - Pa)) return false;
    float z = normal_quantile(Pa + E / ch.c);
    t_event = clamp(ch.tc + z * ch.sd, EPS, tmax);
    return true;
}

bool sample_volume_event(Ray ray, float tmax, out float t_event, out uint id_event) {
    t_event = tmax;
    id_event = uint(-1);
    if (ubo.splats == 0) return false;
    bool found = false;
    vec3 inv = safe_inverse(ray.direction);
    uint stack[MAX_RECURSIVE_DEPTH];
    int stack_ptr = 0;
    stack[stack_ptr++] = ubo.triangles * 2;
    while (stack_ptr > 0) {
        uint node_index = stack[--stack_ptr];
        BVHNode node = nodeIn[node_index];
        if (stack_ptr >= MAX_RECURSIVE_DEPTH - 1) { stack_failure = true; break; }
        float tnear;
        if (!aabb_range(ray, inv, node_index, t_event, tnear)) continue;
        if (node.right == 0xFFFFFFFF) {
            float t;
            if (sample_gaussian_event(ray, node.left, t_event, t)) {
                t_event = t;
                id_event = node.left;
                found = true;
            }
        } else {
            stack[stack_ptr++] = node.left;
            stack[stack_ptr++] = node.right;
        }
    }
    return found;
}

float volume_transmittance(Ray ray, float tmax) {
    if (ubo.splats == 0) return 1.0;
    tmax = min(tmax, VOLUME_TFAR);
    float tau = 0.0;
    vec3 inv = safe_inverse(ray.direction);
    uint stack[MAX_RECURSIVE_DEPTH];
    int stack_ptr = 0;
    stack[stack_ptr++] = ubo.triangles * 2;
    while (stack_ptr > 0 && tau < 20.0) {
        uint node_index = stack[--stack_ptr];
        BVHNode node = nodeIn[node_index];
        if (stack_ptr >= MAX_RECURSIVE_DEPTH - 1) { stack_failure = true; break; }
        float tnear;
        if (!aabb_range(ray, inv, node_index, tmax, tnear)) continue;
        if (node.right == 0xFFFFFFFF) {
            GaussChord ch;
            if (gaussian_chord(ray, node.left, tmax, ch))
                tau += ch.c * (normal_cdf(ch.zb) - normal_cdf(ch.za));
        } else {
            stack[stack_ptr++] = node.left;
            stack[stack_ptr++] = node.right;
        }
    }
    return exp(-tau);
}

float hg_phase(float cos_theta, float g) {
    float denom = 1.0 + g * g - 2.0 * g * cos_theta;
    return (1.0 - g * g) / (4.0 * PI * denom * sqrt(denom));
}

vec3 sample_phase(vec3 forward, float g) {
    float xi1 = random();
    float xi2 = random();
    float cos_theta;
    if (abs(g) < 0.001) {
        cos_theta = 1.0 - 2.0 * xi1;
    } else {
        float sqr = (1.0 - g * g) / (1.0 - g + 2.0 * g * xi1);
        cos_theta = clamp((1.0 + g * g - sqr * sqr) / (2.0 * g), -1.0, 1.0);
    }
    float sin_theta = sqrt(max(0.0, 1.0 - cos_theta * cos_theta));
    float phi = 2.0 * PI * xi2;
    return onb(forward, vec3(sin_theta * cos(phi), sin_theta * sin(phi), cos_theta));
}

vec3 sample_scene_lights_volume(vec3 pos, vec3 travel_dir, vec3 albedo) {
    vec3 intensity = vec3(0);
    for (uint i = 0; i < ubo.lights; i++) {
        SceneLight light = lightIn[i];
        vec3 incoming;
        vec3 to_light = light.position - pos;
        float distance_to_light = length(to_light);
        float falloff = 1.0;
        if (light.angle == 0 && light.direction == vec3(0)) { // point light
            incoming = normalize(to_light);
        } else if (light.angle != 0) { // spot light
            if (light.direction == vec3(0)) light.direction = vec3(0, -1, 0);
            incoming = normalize(to_light);
            float angle = acos(clamp(dot(-incoming, normalize(light.direction)), -1.0, 1.0));
            float lightangle = radians(light.angle / 2.0);
            if (angle > lightangle) continue;
            if (angle > lightangle * (1.0 - light.penumbra)) falloff -= (angle - lightangle * (1.0 - light.penumbra)) / (light.penumbra * lightangle);
        } else { // directional light
            incoming = -normalize(light.direction);
            distance_to_light = FLTMAX;
        }
        Ray sray = Ray(pos, incoming);
        if (ubo.scenelightshadows != 0) {
            uint tid;
            Hit shit = trace(sray, tid);
            if (shit.distance > 0 && shit.distance < distance_to_light) continue;
        }
        float vis = volume_transmittance(sray, distance_to_light);
        intensity += albedo * hg_phase(dot(incoming, travel_dir), SPLAT_G) * light.color * falloff * vis;
    }
    return intensity;
}

vec3 sample_direct_light_volume(vec3 pos, vec3 travel_dir, vec3 albedo) {
    uint eid;
    float area;
    float pmf;
    vec3 light_pos = sample_direct_light_point(eid, area, pmf);
    if (pmf <= 0.0 || area <= 0.0) return vec3(0.0);
    vec3 to_light = light_pos - pos;
    float dist = length(to_light);
    to_light = normalize(to_light);
    Ray sray = Ray(pos, to_light);
    uint tid = 0;
    Hit shit = trace(sray, tid);
    if (eid != tid || shit.distance <= 0.0) return vec3(0.0);
    float cos_light = max(dot(shit.normal, -to_light), 0.0);
    if (cos_light <= 0.0) return vec3(0.0);
    vec3 emission = materialIn[shit.material].emission;
    float p_area = pmf / area;
    float p_omega = p_area * dist * dist / cos_light;
    float vis = volume_transmittance(sray, shit.distance);
    return emission * albedo * hg_phase(dot(to_light, travel_dir), SPLAT_G) * vis / p_omega;
}

vec3 g_first_normal = vec3(0.0, 0.0, 1.0);
float g_first_distance = -1.0;
float g_first_surface = -1.0;

vec3 pathtrace(Ray ray, inout uint hit_id, inout float hit_distance) {
    vec3 throughput = vec3(1.0);
    vec3 radiance = vec3(0.0);
    bool firsthit = true;
    bool firstopaque = true;
    uint hid = -1;
    float ior = 1.0;
    uint medium = AIR_MEDIUM;
    bool count_emission = true;
    float wavelength = -1.0;
    uint i = 0;
    for (; i < ubo.maxbounces; i++) {
        Hit h = trace(ray, hid);
        Material material = materialIn[h.material];
        bool firstsplat = false;
        if (firsthit) {
            firstsplat = true;
            firsthit = false;
            hit_id = hid;
            hit_distance = h.distance;
        }
        if (firstopaque && (material.model != DIELECTRIC_MODEL && material.model != MIRROR_MODEL)) {
            firstopaque = false;
            if (h.distance > 0.0) {
                g_first_normal = dot(h.normal, ray.direction) > 0.0 ? -h.normal : h.normal;
                g_first_distance = h.distance;
                g_first_surface = float(h.material);
            }
        }
        if (ubo.splats > 0) {
            float t_surface = h.distance > 0.0 ? h.distance : VOLUME_TFAR;
            float t_vol;
            uint vol_id;
            if (sample_volume_event(ray, t_surface, t_vol, vol_id)) {
                vec3 albedo = splat_albedo(vol_id);
                if (firstsplat && luminance(albedo) > 0.01) {
                    hit_id = vol_id + ubo.triangles;
                    g_first_normal = -ray.direction;
                    g_first_distance = t_vol;
                    g_first_surface = -2.0;
                }
                if (ubo.splatshadows == 0) {
                    radiance += throughput * albedo;
                    break;
                }
                vec3 vpos = ray.position + ray.direction * t_vol;
                if (ubo.scenelighting != 0 && ubo.lights > 0) {
                    vec3 light = sample_scene_lights_volume(vpos, ray.direction, albedo);
                    radiance += min(throughput * light, max_contribution);
                    if (ubo.scenelightingonly != 0) break;
                }
                if (ubo.direct != 0 && ubo.emissives > 0) {
                    vec3 direct = sample_direct_light_volume(vpos, ray.direction, albedo);
                    radiance += min(throughput * direct, max_contribution);
                    if (ubo.directonly != 0) break;
                }
                throughput *= albedo; // phase / pdf == 1 because we sample the phase function directly
                float pv = russian_roulette(throughput);
                if (random() > pv) break;
                throughput /= pv;
                ray.position = vpos;
                ray.direction = sample_phase(ray.direction, SPLAT_G);
                count_emission = ubo.direct == 0;
                continue;
            }
        }
        if (h.distance <= 0) break;
        bool dispersive = material.model == LAMBERTIAN_MODEL || material.model == SUBSURFACE_MODEL;
        bool reflective = material.model == DIELECTRIC_MODEL || material.model == MIRROR_MODEL;
        if (material.emission != vec3(0.0) && count_emission) {
            radiance += throughput * material.emission;
            break;
        }
        bool same_medium = medium == h.material;
        uint b4medium = medium;
        if (ubo.scenelighting != 0 && ubo.lights > 0 && dispersive) {
            vec3 light = sample_scene_lights(-ray.direction, h, material);
            radiance += min(throughput * light, max_contribution);
            if (ubo.scenelightingonly != 0) break;
        }
        if (ubo.direct != 0 && dispersive && ubo.emissives > 0) {
            vec3 direct = sample_direct_light(-ray.direction, h, material);
            radiance += min(throughput * direct, max_contribution);
            if (ubo.directonly != 0) break;
        }
        vec3 incoming;
        vec3 color;
        float pdf;
        brdf(-ray.direction, ray.position, h, hid, material, incoming, pdf, color, ior, medium, wavelength);
        if (g_sss_exit) {
            // light arriving directly at the exit point of a subsurface cloud path
            g_sss_exit = false;
            uint nee_before = bvh_counter;
            if (ubo.sssexitlight != 0u && pdf > 0.0) {
                vec3 sss_weight = throughput * color / pdf;
                if (ubo.scenelighting != 0 && ubo.lights > 0)
                    radiance += min(sss_weight * sss_exit_scene_lights(g_sss_exit_pos, g_sss_exit_normal, g_sss_exit_axis, g_sss_exit_exponent), max_contribution);
                if (ubo.direct != 0 && ubo.emissives > 0)
                    radiance += min(sss_weight * sss_exit_direct(g_sss_exit_pos, g_sss_exit_normal, g_sss_exit_axis, g_sss_exit_exponent), max_contribution);
            }
            g_sss_debug_cost += bvh_counter - nee_before;
        }
        if (ubo.scenelighting != 0) {
            if (material.model == DIELECTRIC_MODEL && b4medium == -1 && b4medium == medium) {
                vec3 light = sample_scene_lights(-ray.direction, h, material);
                radiance += min(throughput * light, max_contribution);
            }
            if (same_medium && medium != h.material) {
                Hit h2 = h;
                h2.position += EPS * incoming;
                h2.normal *= -1;
                vec3 light = sample_scene_lights(incoming, h2, material);
                radiance += min(throughput * light, max_contribution);
            }
        }
        if (pdf <= 0) break;
        throughput *= color / pdf;
        throughput = min(throughput, max_contribution);
        float p = russian_roulette(throughput);
        if (random() > p) break;
        throughput /= p;
        ray.position = epsilon_offset(h.position, dot(incoming, h.normal) > 0.0 ? h.normal : -h.normal);
        ray.direction = incoming;
        if (reflective) count_emission = true;
        else count_emission = ubo.direct == 0;
    }
    if (ubo.debugmode == DEBUG_BOUNCES) return vec3(pow(float(i) / float(ubo.maxbounces), 2.0), 0, 0);
    if (ubo.debugmode == DEBUG_SSS_PATH) {
        // green: cloud, red: random walk, yellow: cloud whose exit projection failed, grey: no subsurface event
        if (g_sss_debug_kind == 1u) return vec3(0.0, 1.0, 0.0);
        if (g_sss_debug_kind == 2u) return vec3(1.0, 0.0, 0.0);
        if (g_sss_debug_kind == 3u) return vec3(1.0, 1.0, 0.0);
        return vec3(0.05);
    }
    if (ubo.debugmode == DEBUG_SSS_COST) {
        // log scale heat map of BVH nodes visited for subsurface work: black 0, blue ~16, green ~256, red >= 4096
        float t = clamp(log2(1.0 + float(g_sss_debug_cost)) / 12.0, 0.0, 1.0);
        return clamp(vec3(3.0 * t - 1.5, 1.5 - abs(3.0 * t - 1.5), 1.5 - 3.0 * t) * step(0.5, float(g_sss_debug_cost)), 0.0, 1.0);
    }
    return radiance;
}

void main() {
	// update ray info
    raygenIn[gl_GlobalInvocationID.x].tid = -1;

	// create ray generator coordinates	
	int rx = int(gl_GlobalInvocationID.x%int(ubo.width));
    int ry = int(gl_GlobalInvocationID.x/int(ubo.width));

	// reject any rays outside of the viewport
    if (cut_viewport(rx, ry)) return;

    // init random
    init_random(rx, ry);

	// calculate ray color
    uint hit_id = -1;
    float hit_distance = -1.0f;
    vec3 color = pathtrace(create_ray(vec2(rx, ry)), hit_id, hit_distance);
    if (ubo.spectral != 0) color = cheap_spectral_color(color);
    raygenIn[gl_GlobalInvocationID.x].tid = hit_id;
    raygenIn[gl_GlobalInvocationID.x].distance = hit_distance;

    // failures
    if (stack_failure) color = vec3(1.0, 0.0, 0.0);

    // denoiser features
    imageStore(gbufferImage, ivec2(rx, ry), vec4(encode_normal(normalize(g_first_normal)), g_first_distance, g_first_surface));

    // write to image
    if (ubo.reset != 0) {
	    imageStore(hdrImage, ivec2(rx, ry), vec4(color, 1.0));
    } else {
        vec4 accum = imageLoad(hdrImage, ivec2(rx, ry));
        imageStore(hdrImage, ivec2(rx, ry), vec4(color, 0.0) + accum);
    }
}
