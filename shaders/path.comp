#version 450

#define MAX_RECURSIVE_DEPTH 2000
#define MAX_BOUNCES 100
#define EPS 0.0001

#define LAMBERTIAN_MODEL 2
#define MIRROR_MODEL 5
#define DIELECTRIC_MODEL 7

struct RayGenerator {
	float time;
    uint tid;
};

struct Ray {
    vec3 position;
    vec3 direction;
};

