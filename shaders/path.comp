const float max_contribution = 10;
uvec4 seed = uvec4(0);
const uint SOBOL_DIRS[2][32] = uint[2][32](
    uint[32](
        0x80000000u, 0x40000000u, 0x20000000u, 0x10000000u,
        0x08000000u, 0x04000000u, 0x02000000u, 0x01000000u,
        0x00800000u, 0x00400000u, 0x00200000u, 0x00100000u,
        0x00080000u, 0x00040000u, 0x00020000u, 0x00010000u,
        0x00008000u, 0x00004000u, 0x00002000u, 0x00001000u,
        0x00000800u, 0x00000400u, 0x00000200u, 0x00000100u,
        0x00000080u, 0x00000040u, 0x00000020u, 0x00000010u,
        0x00000008u, 0x00000004u, 0x00000002u, 0x00000001u),
    uint[32](
        0x80000000u, 0xC0000000u, 0x60000000u, 0x30000000u,
        0x88000000u, 0x44000000u, 0x22000000u, 0x11000000u,
        0x80800000u, 0x40400000u, 0x20200000u, 0x10100000u,
        0x08080000u, 0x04040000u, 0x02020000u, 0x01010000u,
        0x00808000u, 0x00404000u, 0x00202000u, 0x00101000u,
        0x00080800u, 0x00040400u, 0x00020200u, 0x00010100u,
        0x00008080u, 0x00004040u, 0x00002020u, 0x00001010u,
        0x00000808u, 0x00000404u, 0x00000202u, 0x00000101u)
);

uint sobol(uint index, int dimension) {
    uint result = 0u;
    for (int bit = 0; bit < 32; ++bit) {
        if ((index & (1u << bit)) != 0u)
            result ^= SOBOL_DIRS[dimension][bit];
    }
    return result;
}

uint hash(uint x) {
    x ^= x >> 16;
    x *= 0x7feb352du;
    x ^= x >> 15;
    x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}

uint owen_scramble(uint value, uint seed) {
    uint mask = seed;
    for (uint bit = 0u; bit < 32u; ++bit) {
        uint flip = hash(mask) & 1u;
        value ^= flip << bit;
        mask ^= 0x9e3779b9u;
    }
    return value;
}

float sobol_owen(uint index, int dimension, uint seed) {
    uint v = sobol(index, dimension);
    v = owen_scramble(v, seed + uint(dimension) * 0xA511E9B3u);
    return float(v) * (1.0 / 4294967296.0);
}

float fresnel_dielectric(float cosi, float ior_i, float ior_t) {
    cosi = clamp(cosi, -1.0, 1.0);
    bool entering = cosi > 0.0;
    if (!entering) {
        float tmp = ior_i;
        ior_i = ior_t;
        ior_t = tmp;
        cosi *= -1.0;
    }
    float sint = ior_i / ior_t * sqrt(max(0.0, 1.0 - cosi * cosi));
    if (sint >= 1.0) return 1.0; // total internal reflection
    float cost = sqrt(max(0.0, 1.0 - sint * sint));
    float Rs = (ior_t * cosi - ior_i * cost) / (ior_t * cosi + ior_i * cost);
    float Rp = (ior_i * cosi - ior_t * cost) / (ior_i * cosi + ior_t * cost);
    return 0.5 * (Rs * Rs + Rp * Rp);
}

vec3 background_color(Ray ray) {
    return vec3(0.0);
}

float noise(float n) {
	return fract(n*17.0*fract(n*0.3183099));
}

void init_random(int x, int y) {
    seed = uvec4(x, y, ubo.seed, x + y);
}

void pcg4d(inout uvec4 v) {
    v = v * 1664525u + 1013904223u;
    v.x += v.y * v.w;
    v.y += v.z * v.x;
    v.z += v.x * v.y;
    v.w += v.y * v.z;
    v = v ^ (v >> 16u);
    v.x += v.y * v.w;
    v.y += v.z * v.x;
    v.z += v.x * v.y;
    v.w += v.y * v.z;
}

float random() {
    pcg4d(seed);
    return float(seed.x) / float(0xffffffffu);
}

float luminance(vec3 c) {
    return 0.2126*c.x + 0.7152*c.y + 0.0722*c.z;
}

vec3 beer_lambert(uint material, float dist) {
    return exp(-materialIn[material].absorbtion * dist);
}

Ray create_ray(vec2 rg) {
    uint rayseed = uint(rg.x) * 1973u + uint(rg.y) * 9277u + ubo.samples * 26699u;
    vec2 jitter = vec2(sobol_owen(ubo.samples, 0, rayseed), sobol_owen(ubo.samples, 1, rayseed));
	float r = ubo.width / 2.0;
	float b = ubo.height / 2.0;
	float l = -1.0 * r;
	float t = -1.0 * b;
    float u = l + ((r - l) * (float(rg.x) + jitter.x)) / ubo.width;
    float v = b + ((t - b) * (float(rg.y) + jitter.y)) / ubo.height;
	float d = (cos(ubo.fov / 2.0) / sin(ubo.fov / 2.0)) * r;
    Ray ray;
    if (ubo.focus != 0) {
        vec3 pinhole_dir = normalize((ubo.u * u) + (ubo.v * v) - (ubo.w * d));
        vec3 focal_point = ubo.position + pinhole_dir * ubo.focus;
        float r_lens = sqrt(random());
        float theta = 2.0 * 3.14159265 * random();
        vec2 disk = 0.1 * ubo.aperature * vec2(r_lens * cos(theta), r_lens * sin(theta));
        vec3 lens_offset = (ubo.u * disk.x) + (ubo.v * disk.y);
        ray.position = ubo.position + lens_offset;
        ray.direction = normalize(focal_point - ray.position);
    } else {
        ray.direction = normalize((ubo.u * u) + (ubo.v * v) - (ubo.w * d));
        ray.position = ubo.position;
    }
    return ray;
}

float russian_roulette(vec3 throughput) {
    return clamp(max(max(throughput.x, throughput.y), throughput.z), 0.05, 0.999);
}

vec3 onb(vec3 normal, vec3 local) {
	vec3 w = normal;
	vec3 a = (abs(w.x) > 0.9) ? vec3(0, 1, 0) : vec3(1, 0, 0);
	vec3 v = normalize(cross(w, a));
	vec3 u = normalize(cross(w, v));
	return normalize(local.x*u + local.y*v + local.z*w);
}

vec3 sample_cosine_weighted_lobe() {
    float r1 = random();
    float r2 = random();
    float sqr2 = sqrt(r2);
    float phi = 2.0 * PI * r1;
    return vec3(cos(phi)*sqr2, sin(phi)*sqr2, sqrt(1.0 - r2));
}

vec3 sample_specular_phong_lobe(float shiny) {
    float r1 = random();
    float r2 = random();
    float phi = 2.0 * PI * r1;
    float costheta = pow(r2, 1.0 / (shiny + 1.0));
    float sintheta = sqrt(1.0 - costheta * costheta);
    return vec3(cos(phi) * sintheta, sin(phi) * sintheta, costheta);
}

vec3 sample_direct_light_point(inout uint tid, inout float area) {
    tid = emissiveIn[uint(random()*float(ubo.emissives))];
    Triangle tri = triangleIn[tid];
    vec3 _a = vertexIn[tri.a].xyz;
    vec3 _b = vertexIn[tri.b].xyz;
    vec3 _c = vertexIn[tri.c].xyz;
    area = length(cross(_b - _a, _c - _a)) * 0.5;
    float r1 = sqrt(random());
    float r2 = random();
    float u = 1.0 - r1;
    float v = r2 * r1;
    return _a * (1.0 - u - v) + _b * u + _c * v;
}

float diffuse_pdf(vec3 normal, vec3 incoming) {
    return max(0.0, dot(normal, incoming)) / PI;
}

float specular_pdf(vec3 incoming, vec3 R, float shiny) {
    float cosalpha = max(dot(R, incoming), 0.0);
    return (shiny + 1.0) * pow(cosalpha, shiny) / (2.0 * PI);
}

bool refract_ray(vec3 outgoing, vec3 normal, float eta, out vec3 incoming) {
    float cosi = clamp(dot(-outgoing, normal), -1, 1);
    float k = 1.0 - (eta * eta * (1.0 - cosi * cosi));
    if (k < 0.0) return false;
    float cost = sqrt(k);
    incoming = normalize(eta * (outgoing) + ((eta * cosi - cost) * normal));
    return true;
}

vec3 lambertian_throughput(in vec3 outgoing, in vec3 normal, in vec3 incoming, in Material material) {
    return ((material.diffuse / PI) +
        (material.specular * (material.shiny + 2.0) /
        (2.0 * PI) * pow(max(dot(reflect(-outgoing, normal), incoming), 0.0), material.shiny))) *
        max(0.0, dot(incoming, normal));
}

vec3 sample_direct_light(vec3 outgoing, Hit h, Material material) {
    uint eid;
    float area;
    vec3 pos = sample_direct_light_point(eid, area);
    vec3 to_light = pos - h.position;
    float dist = length(to_light);
    to_light = normalize(to_light);
    Ray sray = { h.position + to_light * EPS, to_light };
    uint tid = 0;
    Hit shit = trace(sray, tid);
    if (eid != tid || shit.distance <= 0.0) return vec3(0.0);
    vec3 emission = materialIn[shit.material].emission;
    float p_triangle = 1.0 / float(ubo.emissives); // TODO: weight this according to triangle weight, not just unform chance from each triangle (do this after implementing sampling a point based on uniform area)
    float p_area = p_triangle / area;
    float cos_light = max(dot(shit.normal, -to_light), 0.0);
    float p_omega = p_area * dist * dist / cos_light;
    float ks = luminance(material.specular);
    float kd = luminance(material.diffuse);
    float kskd = ks + kd;
    float pd = kd/kskd;
    float ps = ks/kskd;
    return emission * lambertian_throughput(outgoing, h.normal, to_light, material) / (p_omega);
}

vec3 sample_scene_lights(vec3 outgoing, Hit h, Material material) {
    vec3 intensity = vec3(0);
    for (uint i = 0; i < ubo.lights; i++) {
        SceneLight light = lightIn[i];
        vec3 incoming;
        vec3 to_light = light.position - h.position;
        float distance_to_light = length(to_light);
        float falloff = 1.0;
        if (light.angle == 0 && light.direction == vec3(0)) { // point light
            incoming = normalize(to_light);
        } else if (light.angle != 0) { // spot light
            if (light.direction == vec3(0)) light.direction = vec3(0, -1, 0);
            incoming = normalize(to_light);
            float angle = acos(clamp(dot(-incoming, normalize(light.direction)), -1.0, 1.0));
            float lightangle = radians(light.angle / 2.0);
            if (angle > lightangle) continue;
            if (angle > lightangle * (1.0 - light.penumbra)) falloff -= (angle - lightangle * (1.0 - light.penumbra)) / (light.penumbra * lightangle);
        } else { // directional light
            incoming = -normalize(light.direction);
            distance_to_light = FLTMAX;
        }
        float ndotl = max(dot(incoming, h.normal), 0.0);
        if (ndotl <= 0) continue;
        if (ubo.scenelightshadows != 0) {
            Ray sray = { h.position + (incoming * (EPS * 100)), incoming };
            uint tid;
            Hit shit = trace(sray, tid);
            if (shit.distance > 0 && shit.distance < distance_to_light) continue;
        }
        intensity += lambertian_throughput(outgoing, h.normal, incoming, material) * light.color * falloff;
    }
    return intensity;
}

float interpolated_ior(in Material material, in float wavelength) {
    float lambdaR = 610.0;
    float lambdaG = 550.0;
    float lambdaB = 460.0;
    if (wavelength >= lambdaG) {
        return mix(material.dispersion.g, material.dispersion.r, (wavelength - lambdaG) / (lambdaR - lambdaG));
    } else {
        return mix(material.dispersion.b, material.dispersion.g, (wavelength - lambdaB) / (lambdaG - lambdaB));
    }
}

vec3 cheap_wavelength_to_rgb(float lambda) {
    float r = 0.0, g = 0.0, b = 0.0;
    if (lambda >= 380.0 && lambda < 440.0) {
        r = -(lambda - 440.0) / (440.0 - 380.0);
        b = 1.0;
    } else if (lambda < 490.0) {
        g = (lambda - 440.0) / (490.0 - 440.0);
        b = 1.0;
    } else if (lambda < 510.0) {
        g = 1.0;
        b = -(lambda - 510.0) / (510.0 - 490.0);
    } else if (lambda < 580.0) {
        r = (lambda - 510.0) / (580.0 - 510.0);
        g = 1.0;
    } else if (lambda < 645.0) {
        r = 1.0;
        g = -(lambda - 645.0) / (645.0 - 580.0);
    } else if (lambda <= 780.0) {
        r = 1.0;
    }
    float s = 1.0;
    if (lambda > 700.0)
        s = 0.3 + 0.7 * (780.0 - lambda) / (780.0 - 700.0);
    else if (lambda < 420.0)
        s = 0.3 + 0.7 * (lambda - 380.0) / (420.0 - 380.0);
    return vec3(r, g, b) * s;
}

vec3 cheap_spectral_color(in vec3 rgb) {
    float lambdaR = 610.0;
    float lambdaG = 550.0;
    float lambdaB = 460.0;
    return cheap_wavelength_to_rgb(lambdaR) * rgb.r + cheap_wavelength_to_rgb(lambdaG) * rgb.g + cheap_wavelength_to_rgb(lambdaB) * rgb.b;
}

void brdf(in vec3 outgoing, in vec3 previous, in Hit h, in Material material, out vec3 incoming, out float pdf, out vec3 throughput, inout float ior, inout uint medium, inout float wavelength) {
    switch (material.model) {
        case LAMBERTIAN_MODEL:
            float ks = luminance(material.specular);
            float kd = luminance(material.diffuse);
            float kskd = ks + kd;
            float pd = kd/kskd;
            float ps = ks/kskd;
            vec3 R = reflect(-outgoing, h.normal);
            incoming = random() < pd ? onb(h.normal, sample_cosine_weighted_lobe()) : onb(R, sample_specular_phong_lobe(material.shiny));
            throughput = 
                ((material.diffuse / PI) +
                (material.specular * (material.shiny + 2.0) /
                (2.0 * PI) * pow(max(dot(R, incoming), 0.0), material.shiny))) *
                max(0.0, dot(incoming, h.normal));
            pdf = (pd * diffuse_pdf(h.normal, incoming) + ps * specular_pdf(incoming, R, material.shiny));
            break;
        case MIRROR_MODEL:
            incoming = reflect(-outgoing, h.normal);
            throughput = material.specular;
            pdf = 1.0;
            break;
        case DIELECTRIC_MODEL:
            float cosi = dot(outgoing, h.normal);
            float eta_i = ior;
            float eta_t = material.ior;
            float pdf_mod = 1.0;
            uint mat_t = h.material;
            vec3 absorb = beer_lambert(medium, length(previous - h.position));
            vec3 wavemask = vec3(1.0);
            if (wavelength < 0 && material.dispersion != vec3(0)) {
                wavelength = mix(380.0, 780.0, random());
                pdf_mod = 1.0 / (780.0 - 380.0);
                wavemask = cheap_wavelength_to_rgb(wavelength);
            }
            if (wavelength >= 0 && material.dispersion != vec3(0)) eta_t *= interpolated_ior(material, wavelength);
            if (medium == mat_t) {
                eta_t = 1.0;
                mat_t = -1;
            }
            float F = fresnel_dielectric(cosi, eta_i, eta_t);
            if (random() < F) {
                incoming = reflect(-outgoing, h.normal);
                throughput = vec3(F) * absorb * cheap_wavelength_to_rgb(wavelength) * wavemask;
                pdf = F * pdf_mod;
            } else {
                float eta = (cosi > 0.0) ? eta_i / eta_t : eta_t / eta_i;
                vec3 Nt = (cosi > 0.0) ? h.normal : -h.normal;
                if (!refract_ray(-outgoing, Nt, eta, incoming)) {
                    incoming = reflect(-outgoing, h.normal);
                    throughput = vec3(1.0) * absorb * wavemask;
                    pdf = F * pdf_mod;
                    return;
                }
                throughput = vec3(1.0 - F) * absorb * wavemask;
                pdf = (1.0 - F) * pdf_mod;
                ior = eta_t;
                medium = mat_t;
            }
            break;
        default: break;
    }
}

vec3 pathtrace(Ray ray, inout uint hit_id, inout float hit_distance) {
    vec3 throughput = vec3(1.0);
    vec3 radiance = vec3(0.0);
    bool firsthit = true;
    uint hid = -1;
    float ior = 1.0;
    uint medium = -1;
    bool count_emission = true;
    float wavelength = -1.0;
    uint i = 0;
    for (; i < ubo.maxbounces; i++) {
        Hit h = trace(ray, hid);
        if (firsthit) {
            firsthit = false;
            hit_id = hid;
            hit_distance = h.distance;
        }
        if (h.distance <= 0) break;
        Material material = materialIn[h.material];
        if (material.emission != vec3(0.0) && count_emission) {
            radiance += throughput * material.emission;
            break;
        }
        if (ubo.scenelighting != 0 && ubo.lights > 0 && material.model == LAMBERTIAN_MODEL) {
            vec3 light = sample_scene_lights(-ray.direction, h, material);
            radiance += min(throughput * light, max_contribution);
            if (ubo.scenelightingonly != 0) break;
        }
        if (ubo.direct != 0 && material.model == LAMBERTIAN_MODEL && ubo.emissives > 0) {
            vec3 direct = sample_direct_light(-ray.direction, h, material);
            radiance += min(throughput * direct, max_contribution);
            if (ubo.directonly != 0) break;
        }
        vec3 incoming;
        vec3 color;
        float pdf;
        brdf(-ray.direction, ray.position, h, material, incoming, pdf, color, ior, medium, wavelength);
        if (pdf <= 0) break;
        throughput *= color / pdf;
        throughput = min(throughput, max_contribution);
        float p = russian_roulette(throughput);
        if (random() > p) break;
        throughput /= p;
        ray.position = h.position + (incoming * EPS);
        ray.direction = incoming;
        if (material.model != LAMBERTIAN_MODEL) count_emission = true;
        else count_emission = ubo.direct == 0;
    }
    if (ubo.debugmode == DEBUG_BOUNCES) return vec3(pow(float(i) / float(ubo.maxbounces), 2.0), 0, 0);
    return radiance;
}

void main() {
	// update ray info
    raygenIn[gl_GlobalInvocationID.x].tid = -1;

	// create ray generator coordinates	
	int rx = int(gl_GlobalInvocationID.x%int(ubo.width));
    int ry = int(gl_GlobalInvocationID.x/int(ubo.width));

	// reject any rays outside of the viewport
    if (cut_viewport(rx, ry)) return;

    // init random
    init_random(rx, ry);

	// calculate ray color
    uint hit_id = -1;
    float hit_distance = -1.0f;
    vec3 color = pathtrace(create_ray(vec2(rx, ry)), hit_id, hit_distance);
    //color = cheap_spectral_color(color);
    raygenIn[gl_GlobalInvocationID.x].tid = hit_id;
    raygenIn[gl_GlobalInvocationID.x].distance = hit_distance;

    // failures
    if (stack_failure) color = vec3(1.0, 0.0, 0.0);

    // write to image
    if (ubo.reset != 0) {
	    imageStore(hdrImage, ivec2(rx, ry), vec4(color, 1.0));
    } else {
        vec4 accum = imageLoad(hdrImage, ivec2(rx, ry));
        imageStore(hdrImage, ivec2(rx, ry), vec4(color, 0.0) + accum);
    }
}
