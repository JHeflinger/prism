    vec3 a;
    vec3 b;
    vec3 c;
    vec3 an;
    vec3 bn;
    vec3 cn;
    uint material;
};

struct Material {
    vec3 emission;
    vec3 ambient;
    vec3 diffuse;
    vec3 specular;
    float ior;
    float shiny;
    uint model;
};

struct NodeBVH {
    vec3 min;
    vec3 max;
    uint config;
    uint left;
    uint right;
};

