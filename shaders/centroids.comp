#import Boilerplate

#import BVHNodeDef;
#import TriangleDef;
#import BoundingBoxDef;
#import SplatDef;

layout(binding = 0) #import GeometryUniformBufferObjectDef ubo;
layout(binding = 1) #import MortonSSBODef;
layout(binding = 2) readonly #import TriangleSSBODef;
layout(binding = 3) readonly #import TransformedVertexSSBODef;
layout(binding = 4) #import IndexSSBODef;
layout(binding = 5) #import BoundingBoxSSBODef;
layout(binding = 6) readonly #import UniformBufferObjectDef uubo;
layout(binding = 7) #import SplatSSBODef;
layout(push_constant) #import PushConstantDef pc;

uint expandBits(uint v) {
    v = (v * 0x00010001u) & 0xFF0000FFu;
    v = (v * 0x00000101u) & 0x0F00F00Fu;
    v = (v * 0x00000011u) & 0xC30C30C3u;
    v = (v * 0x00000005u) & 0x49249249u;
    return v;
}

uint interleaveBits(uint x, uint y, uint z) {
    return (expandBits(x) << 0) | (expandBits(y) << 1) | (expandBits(z) << 2);
}

vec3 world_to_camera(vec3 p) {
    vec3 rel = p - uubo.position;
    return vec3(
        dot(rel, uubo.u),
        dot(rel, uubo.v),
       -dot(rel, uubo.w)
    );
}

bool triangle_in_frustum(in Triangle tri) {
    vec3 p0 = vertexIn[tri.a].xyz;
    vec3 p1 = vertexIn[tri.b].xyz;
    vec3 p2 = vertexIn[tri.c].xyz;
    vec3 v0 = world_to_camera(p0);
    vec3 v1 = world_to_camera(p1);
    vec3 v2 = world_to_camera(p2);
    float nearZ = 0.001;
    float farZ = 1e30;
    float tanHalfFov = tan(uubo.fov * 0.5);
    float aspect = uubo.width / uubo.height;
    if(v0.z < nearZ &&
       v1.z < nearZ &&
       v2.z < nearZ)
        return false;
    if(v0.z > farZ &&
       v1.z > farZ &&
       v2.z > farZ)
        return false;
    if(v0.x < -v0.z * tanHalfFov * aspect &&
       v1.x < -v1.z * tanHalfFov * aspect &&
       v2.x < -v2.z * tanHalfFov * aspect)
        return false;
    if(v0.x > v0.z * tanHalfFov * aspect &&
       v1.x > v1.z * tanHalfFov * aspect &&
       v2.x > v2.z * tanHalfFov * aspect)
        return false;
    if(v0.y < -v0.z * tanHalfFov &&
       v1.y < -v1.z * tanHalfFov &&
       v2.y < -v2.z * tanHalfFov)
        return false;
    if(v0.y > v0.z * tanHalfFov &&
       v1.y > v1.z * tanHalfFov &&
       v2.y > v2.z * tanHalfFov)
        return false;
    return true;
}

bool splat_in_frustum(in GaussianSplat splat, vec3 extents) {
    vec3 center = world_to_camera(splat.position.xyz);
    vec3 e = vec3(
        abs(uubo.u.x) * extents.x +
        abs(uubo.u.y) * extents.y +
        abs(uubo.u.z) * extents.z,
        abs(uubo.v.x) * extents.x +
        abs(uubo.v.y) * extents.y +
        abs(uubo.v.z) * extents.z,
        abs(uubo.w.x) * extents.x +
        abs(uubo.w.y) * extents.y +
        abs(uubo.w.z) * extents.z
    );
    float nearZ = 0.001;
    float farZ = 1e30;
    float tanHalfFov = tan(uubo.fov * 0.5);
    float aspect = uubo.width / uubo.height;
    if (center.z + e.z < nearZ)
        return false;
    if (center.z - e.z > farZ)
        return false;
    float xScale = tanHalfFov * aspect;
    if (center.x + center.z * xScale + e.x + e.z * xScale < 0.0)
        return false;
    if (-center.x + center.z * xScale + e.x + e.z * xScale < 0.0)
        return false;
    float yScale = tanHalfFov;
    if (center.y + center.z * yScale + e.y + e.z * yScale < 0.0)
        return false;
    if (-center.y + center.z * yScale + e.y + e.z * yScale < 0.0)
        return false;
    return true;
}

mat3 quat_to_mat3(vec4 q) {
    float w = q.x;
    float x = q.y;
    float y = q.z;
    float z = q.w;
    return transpose(mat3(
        1.0 - 2.0 * (y * y + z * z),
        2.0 * (x * y - z * w),
        2.0 * (x * z + y * w),
        2.0 * (x * y + z * w),
        1.0 - 2.0 * (x * x + z * z),
        2.0 * (y * z - x * w),
        2.0 * (x * z - y * w),
        2.0 * (y * z + x * w),
        1.0 - 2.0 * (x * x + y * y)
    ));
}

vec3 splatextents(in GaussianSplat splat) {
    const float SIGMA = 3.0;
    vec3 scale = exp(splat.logscale);
    mat3 R = quat_to_mat3(normalize(splat.rotation));
    vec3 ex = R[0] * scale.x;
    vec3 ey = R[1] * scale.y;
    vec3 ez = R[2] * scale.z;
    return SIGMA * vec3(
        length(vec3(ex.x, ey.x, ez.x)),
        length(vec3(ex.y, ey.y, ez.y)),
        length(vec3(ex.z, ey.z, ez.z))
    );
}

void main() {
    if (pc.update != 0) {
        uint spID = gl_GlobalInvocationID.x;
        if (spID >= pc.elements) return;
        indexIn[spID] = spID;
        GaussianSplat splat = splatIn[spID];
        vec3 center = splat.position;
        vec3 extent = splatextents(splat);
        if (uubo.screenspace != 0 && !splat_in_frustum(splat, extent)) {
            center = vec3(0);
            extent = vec3(0);
        }
        vec3 normalized_center = (center - ubo.minBB) / (ubo.maxBB - ubo.minBB);
        uint x = uint(clamp(normalized_center.x * 1024.0, 0.0, 1023.0));
        uint y = uint(clamp(normalized_center.y * 1024.0, 0.0, 1023.0));
        uint z = uint(clamp(normalized_center.z * 1024.0, 0.0, 1023.0));
        mortonIn[spID] = interleaveBits(x, y, z);
        bbIn[spID].minBB = center - extent;
        bbIn[spID].maxBB = center + extent;
    } else {
        uint triID = gl_GlobalInvocationID.x;
        if (triID >= pc.elements) return;
        indexIn[triID] = triID;
        Triangle tri = triangleIn[triID];
        vec3 a = vertexIn[tri.a].xyz;
        vec3 b = vertexIn[tri.b].xyz;
        vec3 c = vertexIn[tri.c].xyz;
        if (uubo.screenspace != 0 && !triangle_in_frustum(tri)) {
            a = vec3(0);
            b = vec3(0);
            c = vec3(0);
        }
        vec3 center = (a + b + c) / 3.0;
        vec3 normalized_center = (center - ubo.minBB) / (ubo.maxBB - ubo.minBB);
        uint x = uint(clamp(normalized_center.x * 1024.0, 0.0, 1023.0));
        uint y = uint(clamp(normalized_center.y * 1024.0, 0.0, 1023.0));
        uint z = uint(clamp(normalized_center.z * 1024.0, 0.0, 1023.0));
        mortonIn[triID] = interleaveBits(x, y, z);
        bbIn[triID].minBB = min(a, min(b, c));
        bbIn[triID].maxBB = max(a, max(b, c));
    }
}
